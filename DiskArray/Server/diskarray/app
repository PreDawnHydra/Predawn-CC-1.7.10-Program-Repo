-- ===========================================================================
--  app.lua   ->  global `app`
-- ---------------------------------------------------------------------------
--  Screen manager + single event loop + declarative registries.
--
--  ONE loop, no parallel(): it pulls every event and routes it. That matters
--  because read() and rednet.receive() both consume events and fight over
--  them; here rednet_message, mouse_*, key, char and timer are all dispatched
--  from one place, so nothing is lost.
--
--  This is the DiskArray copy of the MineSwarm app loop. It adds two things on
--  top: a monitor surface (monitor_touch clicks, monitor_resize) and an onEvent
--  catch-all, so the program can react to hardware events like disk/disk_eject.
--
--  Extensibility contract:
--    app.registerScreen(id, label, builder)  -> adds a sidebar entry, nothing
--                                                else to edit
--    app.registerAction(id, {label,hint,run}) -> appears in action menus
--  Layout is computed from term.getSize() every frame, so the same UI adapts
--  to the 51x19 computer screen or a bigger monitor. The sidebar is a vertical
--  scrolling menu, so the number of screens is not limited by screen width.
-- ===========================================================================

function create(opts)
    opts = opts or {}
    local a = {
        title    = opts.title or "SWARM",
        refresh  = opts.refresh or 1,
        screens  = {},
        order    = {},
        current  = nil,
        actions  = {},
        actionOrder = {},
        focusables  = {},
        focus    = nil,
        defaultKey  = nil,
        running  = false,
        surface  = nil,
        w = 0, h = 0,
        note = "", noteRole = "dim",
        onTick   = opts.onTick,
        onRednet = opts.onRednet,
        onQuit   = opts.onQuit,
        -- onEvent(event, p1, p2, p3, p4) sees EVERY event before the mapping
        -- below runs. Use it for hardware events (disk, disk_eject, ...).
        onEvent  = opts.onEvent,
        -- The bottom status row is optional: with showStatusBar = false the
        -- body spans to the last row and notes go to the title bar instead.
        showStatusBar = opts.showStatusBar ~= false,
        -- press feedback and note lifetime
        pressed  = nil,
        noteAt   = 0,
        noteFor  = opts.noteFor or 8,
        menuWidget = nil,
        menuW      = 0,
        statusWidget = nil,
        statusRight = opts.statusRight or "",
    }

    -----------------------------------------------------------------------
    -- Registries
    -----------------------------------------------------------------------
    function a.registerScreen(id, labelText, builder)
        if not a.screens[id] then table.insert(a.order, id) end
        a.screens[id] = { id = id, label = labelText, builder = builder }
        -- Keep the sidebar in step if the chrome already exists, so a screen
        -- registered after startup still shows up (and can overflow the menu).
        if a.menuWidget then a.menuWidget = a.makeMenu() end
    end

    function a.registerAction(id, def)
        if not a.actions[id] then table.insert(a.actionOrder, id) end
        a.actions[id] = def
    end

    function a.runAction(id)
        local act = a.actions[id]
        if not act then a.notify("no such action: " .. tostring(id), "error") return false end
        local ok, err = pcall(act.run)
        if not ok then a.notify("action failed: " .. tostring(err), "error") end
        return ok
    end

    function a.addFocusable(w)
        table.insert(a.focusables, w)
        return w
    end

    function a.setFocus(w)
        for i = 1, #a.focusables do
            a.focusables[i].focused = (a.focusables[i] == w)
        end
        a.focus = w
    end

    function a.notify(msg, role)
        a.note = tostring(msg or "")
        a.noteRole = role or "dim"
        a.noteAt = os.clock()
    end

    -- The status bar note is a transient acknowledgement, not a permanent
    -- banner: once it goes stale the hint text has the row to itself again.
    function a.expireNote()
        if a.note ~= "" and (os.clock() - a.noteAt) > a.noteFor then
            a.note, a.noteRole = "", "dim"
        end
    end

    -----------------------------------------------------------------------
    -- Press feedback. A button lights up on mouse_click and goes back on
    -- mouse_up; a monitor touch (monitor_touch) has no release event, so the
    -- tick clears it as well.
    -----------------------------------------------------------------------
    function a.setPressed(w)
        a.clearPressed()
        a.pressed = w
        w.pressed = true
    end

    function a.clearPressed()
        if a.pressed then
            a.pressed.pressed = nil
            a.pressed = nil
        end
    end

    -----------------------------------------------------------------------
    -- Screens
    -----------------------------------------------------------------------
    function a.show(id)
        if not a.screens[id] then return false end
        a.current = id
        -- Keep the sidebar's own notion of "current" in step with the app, so a
        -- programmatic show() cannot desync it and silently disable Enter.
        if a.menuWidget then
            a.menuWidget.current = id
            a.menuWidget.highlight = id
        end
        a.rebuild()
        return true
    end

    function a.rebuild()
        a.focusables = {}
        a.focus = nil
        a.defaultKey = nil
        local scr = a.screens[a.current]
        if not scr then return end
        local root = widget.new({ x = 1, y = 1, w = a.w, h = a.h })
        a.root = root
        local ok, err = pcall(scr.builder, a, root)
        if not ok then
            a.notify("screen error: " .. tostring(err), "error")
        end
        -- Auto-register every focusable control in the new tree, so screens
        -- never have to wire keyboard navigation themselves.
        local function collect(node)
            if node.focusable then table.insert(a.focusables, node) end
            for i = 1, #(node.children or {}) do collect(node.children[i]) end
        end
        collect(root)
    end

    -- Move keyboard focus through the screen's controls.
    function a.cycleFocus(delta)
        if #a.focusables == 0 then return end
        local pos = 0
        for i = 1, #a.focusables do
            if a.focusables[i] == a.focus then pos = i break end
        end
        if pos == 0 then
            a.setFocus(a.focusables[1])
        else
            local nxt = ((pos - 1 + delta) % #a.focusables) + 1
            -- One full cycle releases focus, so the arrows go back to the tabs.
            if (delta > 0 and nxt == 1) or (delta < 0 and nxt == #a.focusables) then
                a.setFocus(nil)
            else
                a.setFocus(a.focusables[nxt])
            end
        end
    end

    -- Body region: right of the sidebar, below the title bar, above the status
    -- bar. The sidebar owns columns 1..menuW, with a one-cell border gutter at
    -- menuW+1, so content starts at menuW+2.
    -- Body region: right of the sidebar, below the title bar, and down to the
    -- last row (or one above it when the status bar is showing).
    function a.bottomRow()
        return a.h - (a.showStatusBar and 1 or 0)
    end

    function a.body()
        local m = a.menuW
        return { x = m + 2, y = 2,
                 w = math.max(a.w - m - 1, 1),
                 h = math.max(a.bottomRow() - 1, 1) }
    end

    -----------------------------------------------------------------------
    -- Drawing
    -----------------------------------------------------------------------
    -- Build the sidebar model from the registered screens. Width follows the
    -- longest label but never takes more than a third of the terminal.
    function a.makeMenu()
        local items = {}
        local maxLabel = 0
        for i = 1, #a.order do
            local id = a.order[i]
            local lbl = a.screens[id].label
            table.insert(items, { id = id, label = lbl })
            maxLabel = math.max(maxLabel, #lbl)
        end
        a.menuW = math.max(8, math.min(maxLabel + 3, math.max(8, math.floor(a.w / 3))))
        local m = widgets.menu({
            x = 1, y = 2, w = a.menuW, h = math.max(a.bottomRow() - 1, 1),
            items = items,
            current = a.current or (items[1] and items[1].id),
            onSelect = function(id)
                a.show(id)
                a.notify("view: " .. (a.screens[id] and a.screens[id].label or id), "dim")
            end,
        })
        m.highlight = m.current
        return m
    end

    -- Build the chrome (sidebar + status bar). Called whenever the terminal
    -- size changes, so the geometry always matches the current width/height.
    function a.buildChrome()
        a.menuWidget = a.makeMenu()
        if a.showStatusBar then
            a.statusWidget = widgets.statusbar({
                x = 1, y = a.h, w = a.w, h = 1,
                left  = function() return a.note end,
                -- While a note is live it owns the whole row. Drawing the key
                -- hint at the same time is what left a faint fragment of the
                -- note behind; the hint comes back when the note expires.
                right = function()
                    if a.note ~= "" then return "" end
                    return a.statusRightText and a.statusRightText() or ""
                end,
            })
        else
            a.statusWidget = nil
        end
    end

    -- What goes in the top-right corner: a live note wins, otherwise the
    -- program's own status text. With no status bar this is the only place a
    -- note (or an action failure) can be seen.
    function a.titleRight()
        if a.note ~= "" then return a.note end
        local r = a.statusRight
        if type(r) == "function" then r = r() end
        return r or ""
    end

    function a.ensureSurface()
        local tw, th = term.getSize()
        if a.surface and a.w == tw and a.h == th then return true end
        a.w, a.h = tw, th
        a.surface = window.create(term.current(), 1, 1, tw, th, false)
        a.buildChrome()
        if a.current then a.rebuild() end
        return true
    end

    function a.drawChrome()
        local s = a.surface
        -- Title bar
        widget.fill(s, 1, 1, a.w, 1, theme.c("accent"))
        widget.text(s, 2, 1, widget.clip(a.title, a.w - 2), theme.c("onAccent"), theme.c("accent"))
        local right = a.titleRight()
        if right and #right > 0 then
            widget.text(s, a.w - #right, 1, widget.clip(right, a.w - 2), theme.c("onAccent"), theme.c("accent"))
        end
        -- Sidebar, plus a one-cell gutter separating it from the content area.
        if a.menuWidget then a.menuWidget:drawAll(s) end
        widget.fill(s, a.menuW + 1, 2, 1, math.max(a.bottomRow() - 1, 1), theme.c("gutter"))
        -- Status bar (only when the program asks for one)
        if a.statusWidget then a.statusWidget:drawAll(s) end
    end

    function a.draw()
        a.ensureSurface()
        local s = a.surface
        s.clear()
        -- Body background first, then screen content, then chrome on top.
        widget.fill(s, 1, 1, a.w, a.h, theme.c("desktop"))
        if a.root then a.root:drawAll(s) end
        a.drawChrome()
        -- The cursor belongs to the surface, not to a widget: left alone it
        -- sits and blinks wherever the last draw wrote (bottom right), and the
        -- chrome text runs after the body. Only a focused text field gets one.
        local f = a.focus
        if f ~= nil and f.kind == "field" and f.caretX then
            s.setCursorBlink(true)
            s.setCursorPos(f.caretX, f.caretY)
        else
            s.setCursorBlink(false)
            s.setCursorPos(1, 1)
        end
        s.setVisible(true)
        s.redraw()
    end

    -----------------------------------------------------------------------
    -- Event routing
    -----------------------------------------------------------------------
    function a.onClick(x, y, button)
        if a.menuWidget and a.menuWidget:contains(x, y) then
            a.menuWidget.onClick(button, x, y)
            return
        end
        if y == a.h and a.statusWidget then return end
        local hit = a.root and a.root:hitTest(x, y)
        if not hit then a.setFocus(nil) return end
        -- A button is activated by the click, so it must NOT take the keyboard
        -- focus: leaving the focus on it kept the button highlighted after the
        -- click, which reads as the click never having been released. Tab and
        -- the arrow keys still move focus, so the keyboard path is unaffected.
        if hit.kind == "button" then
            a.setPressed(hit)
            a.setFocus(nil)
            -- Visible acknowledgement that the click landed; the button's own
            -- action may overwrite this with a more specific message.
            a.notify("-> " .. (hit.label or "action"), "dim")
        else
            -- Focus follows the click for the other focusable widgets (fields).
            local isFocusable = false
            for i = 1, #a.focusables do
                if a.focusables[i] == hit then isFocusable = true break end
            end
            if isFocusable then a.setFocus(hit) else a.setFocus(nil) end
        end
        local ok, err = pcall(hit.onClick, button, x, y)
        if not ok then a.notify("click failed: " .. tostring(err), "error") end
    end

    function a.onScroll(dir, x, y)
        -- The wheel scrolls the sidebar when it is over the sidebar, and the
        -- widget under the pointer everywhere else.
        if a.menuWidget and a.menuWidget:contains(x, y) then
            a.menuWidget.onScroll(dir, x, y)
            return
        end
        local hit = a.root and a.root:hitTest(x, y)
        if hit and hit.onScroll then hit.onScroll(dir, x, y) end
    end

    -- Keyboard model for a sidebar layout:
    --   Up/Down   move the sidebar cursor when nothing is focused, otherwise
    --             drive the focused control (or step between buttons)
    --   Enter     commit the sidebar cursor, or activate the focused control
    --   Right     step from the sidebar into the screen's controls
    --   Left      step back out to the sidebar
    --   Tab       cycle focus through the screen's controls
    function a.onKey(key)
        local function send(target)
            if target and target.onKey then
                local ok, err = pcall(target.onKey, key)
                if not ok then a.notify("key failed: " .. tostring(err), "error") end
                return true
            end
            return false
        end

        if key == keys.tab then
            a.cycleFocus(1)
            return
        end

        -- A text field owns the arrow keys while it has focus.
        local fieldFocused = (a.focus ~= nil and a.focus.kind == "field")

        if key == keys.right then
            if fieldFocused then
                send(a.focus)
            elseif #a.focusables > 0 then
                a.setFocus(a.focusables[1])
            end
            return
        end

        if key == keys.left then
            if fieldFocused then
                send(a.focus)
            elseif a.focus then
                a.setFocus(nil)
            end
            return
        end

        if key == keys.up or key == keys.down then
            local d = (key == keys.down) and 1 or -1
            if a.focus and a.focus.kind == "button" then
                a.cycleFocus(d)
            elseif a.focus then
                send(a.focus)
            elseif a.menuWidget then
                a.menuWidget.move(d)
            end
            return
        end

        if key == keys.enter then
            if a.focus then
                send(a.focus)
            elseif a.menuWidget then
                a.menuWidget.activate()
            end
            return
        end

        send(a.focus or a.defaultKey)
    end

    function a.onChar(ch)
        if a.focus and a.focus.buffer then
            widgets.appendChar(a.focus, ch)
        end
    end

    -- Single seam mapping an event to its handler. CC's argument orders are
    -- verified from WidgetTerminal bytecode: mouse_click / mouse_up / mouse_drag
    -- are (button, x, y) -- NOT (x, y, button) -- and mouse_scroll is
    -- (direction, x, y) with direction -1 = up, 1 = down.
    --
    -- A monitor has no mouse in 1.75: TileMonitor queues monitor_touch with
    -- (attachmentName, x, y) when a player clicks the monitor, and there is no
    -- monitor_click/monitor_up at all. Coordinates are monitor cells, which are
    -- exactly the cells of the redirected terminal, so a touch maps straight
    -- onto a left click.
    function a.dispatch(event, p1, p2, p3, p4)
        if a.onEvent then pcall(a.onEvent, event, p1, p2, p3, p4) end
        if event == "mouse_click" then
            a.onClick(p2, p3, p1)
        elseif event == "monitor_touch" then
            a.onClick(p2, p3, 1)
        elseif event == "monitor_resize" then
            -- ensureSurface() notices the new size on the next draw.
        elseif event == "mouse_up" then
            a.clearPressed()
        elseif event == "mouse_drag" then
            -- reserved for drag support
        elseif event == "mouse_scroll" then
            a.onScroll(p1, p2, p3)
        elseif event == "key" then
            a.onKey(p1)
        elseif event == "char" then
            a.onChar(p1)
        elseif event == "rednet_message" then
            if a.onRednet then pcall(a.onRednet, p1, p2, p3) end
        elseif event == "terminate" then
            a.running = false
        end
    end

    function a.run()
        a.running = true
        if not a.current and a.order[1] then a.current = a.order[1] end
        a.ensureSurface()
        a.buildChrome()
        a.rebuild()

        a.timerToken = os.startTimer(a.refresh)
        while a.running do
            a.draw()
            local event, p1, p2, p3, p4 = os.pullEvent()
            if event == "timer" and p1 == a.timerToken then
                a.timerToken = os.startTimer(a.refresh)
                a.clearPressed()
                a.expireNote()
                if a.onTick then pcall(a.onTick) end
            else
                a.dispatch(event, p1, p2, p3, p4)
            end
        end
        if a.onQuit then a.onQuit() end
    end

    function a.stop()
        a.running = false
    end

    return a
end
