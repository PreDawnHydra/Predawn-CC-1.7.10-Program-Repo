-- ===========================================================================
--  builder   ->  global `builder`
-- ---------------------------------------------------------------------------
--  The rules behind the Builder screen: what may join an array, what a build
--  would do, and how to repair one. They live here rather than in the screen so
--  the rules are testable without a UI, and so the preview shown before a write
--  and the write itself go through the same slot planner (pool.planSlots) and
--  cannot disagree.
--
--  Drive KEYS are used everywhere: a side name for a local drive, "#7:back" for
--  one behind a modem. A remote disk is enrolled by asking its host to write the
--  manifest, so the array definition still lives on the floppy either way.
-- ===========================================================================

local MAX_NAME = 24

---------------------------------------------------------------------------
-- Layout modes. Only "plain" writes anything yet; the others are listed so the
-- UI can say so honestly instead of offering a button that lies.
---------------------------------------------------------------------------
function modes()
    return {
        { id = "plain",  label = "plain",  ready = true,
          note = "each member holds its own files; one lost member loses only its own files" },
        { id = "mirror", label = "mirror", ready = false,
          note = "every file written to every member - survives a disk dying (not written yet)" },
        { id = "span",   label = "span",   ready = false,
          note = "one volume striped across the members (not written yet)" },
    }
end

function modeReady(id)
    local m = modes()
    for i = 1, #m do if m[i].id == id then return m[i].ready end end
    return false
end

---------------------------------------------------------------------------
-- Names
---------------------------------------------------------------------------
-- Plain text only, capped: the name goes into a manifest that every member
-- carries, and it has to survive textutils.serialize and a 51-column screen.
function cleanName(s)
    if type(s) ~= "string" then return nil end
    s = s:gsub("[^%w%-%_ ]", "")
    s = (s:match("^%s*(.-)%s*$")) or s
    if #s > MAX_NAME then s = string.sub(s, 1, MAX_NAME) end
    if s == "" then return nil end
    return s
end

---------------------------------------------------------------------------
-- What a drive can do
---------------------------------------------------------------------------
-- Returns ok, why. The Builder shows `why` next to every drive it will not
-- take, so a greyed-out row always explains itself.
function usable(r, arrayID)
    if not r then return false, "gone from the pool" end
    if not r.mount then
        if r.hasDisk then return false, "disk has no data folder (format it first)" end
        return false, "no disk in the drive"
    end
    if r.readOnly == true then return false, "read-only disk" end
    if r.manifest then
        if arrayID and r.manifest.array == arrayID then return true, "already a member" end
        return false, "member of " .. tostring(r.manifest.array) .. " - Forget it first"
    end
    return true, "free disk"
end

-- Drives that could join something right now.
function candidates()
    local out, recs = {}, pool.drives()
    for i = 1, #recs do
        local r = recs[i]
        local ok = usable(r)
        if ok then table.insert(out, r) end
    end
    return out
end

-- Local drives first, then remote ones by computer: a long list reads better
-- grouped by where the drive physically is.
function sortedKeys(list)
    local out = {}
    for i = 1, #(list or {}) do
        local r = pool.get(list[i])
        if r then table.insert(out, r) end
    end
    table.sort(out, function(a, b)
        local ca, cb = a.computer or 0, b.computer or 0
        if ca ~= cb then return ca < cb end
        return tostring(a.key) < tostring(b.key)
    end)
    local keys = {}
    for i = 1, #out do table.insert(keys, out[i].key) end
    return keys
end

---------------------------------------------------------------------------
-- Plan: what a build or a join WOULD do, without touching a disk
---------------------------------------------------------------------------
-- opts = { mode = "plain", name = "MUSIC", array = "DA8.x" (join an existing
-- array instead of starting one) }
function plan(keys, opts)
    opts = opts or {}
    local p = {
        ok = true, keys = {}, lines = {}, warnings = {},
        mode = opts.mode or "plain",
        name = cleanName(opts.name),
        rawName = opts.name,
        array = opts.array,
        free = 0, remote = 0,
    }
    if type(keys) ~= "table" or #keys == 0 then
        p.ok = false
        table.insert(p.warnings, "select at least one drive")
    end
    if opts.name ~= nil and opts.name ~= "" and p.name == nil then
        table.insert(p.warnings, "name has no usable letters (letters, numbers, - and _ only)")
    end
    if not modeReady(p.mode) then
        p.ok = false
        table.insert(p.warnings, "mode '" .. p.mode .. "' is not implemented yet - use plain")
    end

    local seen = {}
    for i = 1, #keys do
        local key = keys[i]
        local r = pool.get(key)
        local ok, why = usable(r, p.array)
        if not ok then
            p.ok = false
            table.insert(p.warnings, tostring(key) .. ": " .. why)
        elseif seen[key] then
            table.insert(p.warnings, tostring(key) .. " is listed twice")
        else
            seen[key] = true
            table.insert(p.keys, key)
            if r.computer then p.remote = p.remote + 1 end
            if type(r.free) == "number" then p.free = p.free + r.free end
        end
    end

    -- Slots come from the same planner the write uses, so the preview is the
    -- truth rather than a guess.
    if #p.keys > 0 then
        local arrayID = p.array
        if not arrayID then
            for i = 1, #p.keys do
                local r = pool.get(p.keys[i])
                if r.manifest and r.manifest.array then arrayID = r.manifest.array break end
            end
        end
        if not arrayID then arrayID = "(new array)" end
        local slots = pool.planSlots(arrayID, p.keys)
        p.array = (arrayID == "(new array)") and nil or arrayID
        for i = 1, #slots do
            local r = pool.get(slots[i].key)
            local where = r.computer and ("host #" .. r.computer) or "local"
            table.insert(p.lines, string.format("slot %-3s %-14s %-10s %s  %s",
                tostring(slots[i].slot), r.key, r.label or "(no label)",
                pool.bytes(r.free or 0) .. " free", where))
        end
    end
    return p
end

---------------------------------------------------------------------------
-- Do it
---------------------------------------------------------------------------
function create(keys, opts)
    local p = plan(keys, opts)
    if not p.ok then return false, table.concat(p.warnings, "; "), p end
    local ok, msg = pool.initArray(p.mode, p.keys, p.name, p.array)
    return ok, msg, p
end

-- One disk into an existing array. It lands in the lowest hole; nobody else
-- moves.
function join(arrayID, key)
    if type(arrayID) ~= "string" or arrayID == "" then return false, "no array selected" end
    return create({ key }, { array = arrayID, mode = "plain" })
end

-- Take one disk out of its array: clears the manifest, leaves the files alone.
function leave(key)
    local r = pool.get(key)
    if not r then return false, "no such drive: " .. tostring(key) end
    if not r.manifest then return false, tostring(key) .. " is not a member of an array" end
    return pool.clearManifest(key)
end

-- Rename an array: rewrite every member's manifest with the new name. Slots and
-- member ids do not move, so this is safe to do at any time.
function rename(arrayID, name)
    local clean = cleanName(name)
    if not clean then return false, "name needs letters, numbers, - or _" end
    local a = nil
    local all = pool.arrays()
    for i = 1, #all do if all[i].id == arrayID then a = all[i] break end end
    if not a then return false, "no such array: " .. tostring(arrayID) end

    local written, failed = 0, {}
    for i = 1, #a.members do
        local r = a.members[i]
        local members = {}
        for s = 1, a.expected do members[s] = manifest.memberID(arrayID, s) end
        local ok, msg = pool.writeManifest(r, manifest.build(arrayID, r.slot, members,
                                                             r.mode or "plain", clean))
        if ok then written = written + 1
        else table.insert(failed, r.key .. ": " .. tostring(msg)) end
    end
    pool.scan()
    if written == 0 then return false, "renamed nothing (" .. table.concat(failed, "; ") .. ")" end
    local msg = "renamed " .. arrayID .. " to '" .. clean .. "' (" .. written .. " disk(s))"
    if #failed > 0 then msg = msg .. ", failed " .. table.concat(failed, "; ") end
    return true, msg
end

-- A ready-made suggestion for the New tab: every free writable disk, local ones
-- first. Pressing Create without thinking still gives a sensible array.
function suggest()
    local out = {}
    local c = candidates()
    for i = 1, #c do table.insert(out, c[i].key) end
    return sortedKeys(out)
end
