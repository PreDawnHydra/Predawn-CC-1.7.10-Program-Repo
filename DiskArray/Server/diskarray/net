-- net: the DiskArray rednet protocol, BOTH ends.
--
-- Both halves live in one module on purpose: they are pure functions over
-- tables, so the offline tests can run a real host and a real server against
-- each other in the same Lua state and check the wire format for real, without
-- a modem in sight. The rednet plumbing itself (open/send/receive) is thin glue
-- and stays in the entry programs.
--
-- Protocol v1, protocol id "diskarray". Messages are plain tables: rednet in
-- 1.75 carries tables natively, so there is no JSON anywhere in this program.
--
--   ping  { p, t, from, v }                          broadcast: who has drives?
--   hosts { p, t, from, v, computer, seq, last, total, drives = { ... } }
--                                                    reply to a ping, or a push
--   query { p, t, from, v, to }                      ask one host for a list
--   act   { p, t, from, v, to, side, action, label } eject / label a remote disk
--   ack   { p, t, from, v, to, ok, msg }             answer to act
--   bye   { p, t, from, v }                          host is going away
--
-- File ops (v1, added with the transfer slice) - all paths are RELATIVE to the
-- drive's mount, and the host is the only thing that touches its own filesystem:
--   fstat {p,t,from,v,to,path}                    -> {t="fstat",size,lines,sum,trailing}
--   fread {p,t,from,v,to,path}                    -> {t="flines",path,lines={...},sum,trailing}
--   fwipe {p,t,from,v,to,path}                    truncate/create, then ack
--   fchunk{p,t,from,v,to,path,off,part,sum,last}  append one piece, then ack
--   fdir  {p,t,from,v,to,path}                    -> {t="flist",path,names={...}}
--   fdel  {p,t,from,v,to,path}                    ack
--
-- A remote drive record is deliberately small and deliberately NOT a live
-- handle: it is a snapshot the host took, with the manifest flattened to the
-- four fields the array maths needs plus the member count. Reading a file on
-- another computer is a different conversation (see chunk/checksum below), and
-- nothing here pretends a remote drive is as cheap as a local one.
--
-- Message size: this build puts no small hard cap on a wired-modem message -
-- the only constant in the modem path is 128 open channels per modem
-- (ModemPeripheral.openChannel) - but nothing proves the limit is large either.
-- So drive lists are BATCHED by count and every batch carries seq/last/total:
-- a conversation that got cut short is visible as `incomplete` instead of
-- quietly losing the drives at the end.

local PROTO   = "diskarray"
local VERSION = 2          -- v2 = keyed peers (see the trust section)
local BATCH   = 12          -- drives per hosts message

---------------------------------------------------------------------------
-- Wire helpers
---------------------------------------------------------------------------
function protocol() return PROTO end
function version()  return VERSION end
function batchSize() return BATCH end

-- A rolling 31-bit checksum. Modulo 2^31-1 keeps every intermediate exact in a
-- Lua double (31 * 2^31 < 2^53), so the number survives the trip through the
-- modem and through textutils.serialize unchanged.
function checksum(s)
    local h = 0
    for i = 1, #s do
        h = (h * 31 + string.byte(s, i)) % 2147483647
    end
    return h
end

-- Split text into tagged pieces. This is what cross-computer file transfer will
-- use once an array places data on a drive behind a modem; it lives here so it
-- is tested before anything depends on it.
function chunk(s, size)
    size = (type(size) == "number" and size > 0) and math.floor(size) or 512
    local out, n, i = {}, 0, 1
    while true do
        local part = string.sub(s, i, i + size - 1)
        if part == "" then break end
        n = n + 1
        table.insert(out, { i = n, part = part, sum = checksum(part),
                            last = (i + size > #s) })
        i = i + size
    end
    return out
end

-- Reassemble, verifying every piece. Returns the text, or nil and a reason: a
-- silent corruption here would write a file that only looks right.
function unchunk(parts)
    if type(parts) ~= "table" or #parts == 0 then return nil, "no pieces" end
    local seen, out, expect = {}, {}, 1
    for i = 1, #parts do
        local p = parts[i]
        if type(p) ~= "table" or type(p.i) ~= "number" or type(p.part) ~= "string" then
            return nil, "malformed piece"
        end
        if seen[p.i] then return nil, "duplicate piece " .. tostring(p.i) end
        if type(p.sum) == "number" and p.sum ~= checksum(p.part) then
            return nil, "piece " .. tostring(p.i) .. " failed its checksum"
        end
        seen[p.i] = p.part
        if p.i >= expect then expect = p.i + 1 end
    end
    local last = nil
    for i = 1, #parts do if parts[i].last then last = parts[i].i end end
    if last == nil then return nil, "no last piece" end
    for i = 1, last do
        if not seen[i] then return nil, "missing piece " .. tostring(i) end
        table.insert(out, seen[i])
    end
    return table.concat(out)
end

---------------------------------------------------------------------------
-- Trust
--
-- Any computer on the wire that speaks "diskarray" could claim to be a host,
-- and any computer could tell a real host to eject a disk. --allow is a fence
-- of computer IDs, and IDs are visible to everyone; they decide who is ALLOWED
-- to be asked, not who can PROVE who they are. A shared passphrase is the only
-- secret ComputerCraft 1.75 offers - and 1.75 has no crypto library at all: no
-- md5, no sha, no hmac. So this is a keyed 32-bit digest plus a challenge that
-- changes every contact.
--
-- What that buys: a stranger on the wire cannot join your pool, cannot inject
-- fake drives, and cannot order your hosts around, because it does not know the
-- phrase and cannot answer a challenge it has never seen.
-- What it does NOT buy: it is not a signature. Someone who taps your wire,
-- captures a challenge and its answer, and has hours of ComputerCraft time could
-- search for a phrase that matches. If that player is a real threat, move the
-- computers onto separate rednets instead of relying on this.
---------------------------------------------------------------------------
local function mul32(a, b)
    -- (a*b) mod 2^32 without ever exceeding 2^53, where a Lua double stops
    -- being exact: 4.29e9 * 1.67e7 = 7.2e16 is NOT an integer in Lua, and the
    -- low bits come off as garbage. Splitting the multiplicand keeps every
    -- intermediate below 1.1e12.
    local ahi, alo = math.floor(a / 65536), a % 65536
    return (alo * b + math.fmod(ahi * b, 65536) * 65536) % 4294967296
end

function keyDigest(pass, text)
    if type(pass) ~= "string" or pass == "" then return nil end
    local h = 2166136261
    local function mix(str)
        for i = 1, #str do
            h = (h + string.byte(str, i)) % 4294967296
            h = mul32(h, 16777619)
        end
    end
    -- secret around the text, so the answer does not depend on the text alone
    mix(pass); mix(tostring(text or "")); mix(pass)
    return h
end

local secret, tag = nil, nil

-- Returns the tag that goes on the wire, or nil when no key is set. The
-- passphrase itself is never sent.
function setKey(pass)
    if type(pass) ~= "string" or pass == "" then
        secret, tag = nil, nil
        return nil
    end
    secret, tag = pass, keyDigest(pass, PROTO .. "/" .. VERSION)
    return tag
end
function key()     return tag end
function locked()  return tag ~= nil end
function answer(n) return tag == nil and nil or keyDigest(secret, n) end


---------------------------------------------------------------------------
-- Message constructors (used by both ends)
---------------------------------------------------------------------------
local seq = 0
local function nextID() seq = seq + 1 return seq end
function requestID() return seq end

local function base(t, from)
    -- k is the key tag: it says "this sender knows the passphrase", and it is
    -- checked before a single drive name is handed over.
    return { p = PROTO, t = t, from = from, v = VERSION, id = nextID(), k = tag }
end

-- A locked host announces itself with hello: no side names, no labels, no free
-- space. Layout is the thing worth keeping off a shared wire.
function helloMsg(from) return base("hello", from) end

function chalMsg(from, to, nonce)
    local m = base("chal", from); m.to = to; m.n = nonce; return m
end

function chalrMsg(from, to, nonce, ans)
    local m = base("chalr", from); m.to = to; m.n = nonce; m.a = ans; return m
end

---------------------------------------------------------------------------
-- A peer is trusted once it has answered a challenge we issued. Both ends use
-- this: the server proves itself to the host, and the host to the server.
---------------------------------------------------------------------------
function trust(opts)
    local t = {
        computer = opts.computer,
        verified = {},      -- peer id -> true
        failed   = {},      -- peer id -> why
        sent     = {},      -- nonce -> the peer we challenged
        nSent    = 0,
    }
    local MAX_PENDING = 32

    local function prune()
        -- bounded: a hostile peer could spray challenges to grow this table
        if t.nSent <= MAX_PENDING then return end
        for n in pairs(t.sent) do
            t.sent[n] = nil
            t.nSent = t.nSent - 1
            if t.nSent <= MAX_PENDING then break end
        end
    end

    function t.locked() return tag ~= nil end
    function t.ok(id)   return tag == nil or t.verified[id] == true end

    function t.challenge(to)
        if tag == nil then return nil end
        local n = tostring(t.computer) .. ":" .. tostring(nextID())
        t.sent[n] = to
        t.nSent = t.nSent + 1
        prune()
        return chalMsg(t.computer, to, n)
    end

    -- Returns the messages to send back, or nil if this is not a trust message.
    function t.onMessage(m, from)
        if m.t == "chal" then
            if tag == nil then return {} end
            if m.k ~= tag then
                t.failed[from] = "wrong or missing key"
                return {}
            end
            t.failed[from] = nil
            local reps = { chalrMsg(t.computer, from, m.n, answer(m.n)) }
            if not t.verified[from] then
                local c = t.challenge(from)
                if c then table.insert(reps, c) end
            end
            return reps
        elseif m.t == "chalr" then
            if tag == nil then return {} end
            if m.k ~= tag then
                t.failed[from] = "wrong or missing key"
                return {}
            end
            -- the nonce must be ours AND aimed at this sender: an answer copied
            -- off the wire, or replayed after we stopped waiting for it, fails here
            if t.sent[m.n] ~= from then
                -- Someone answered a challenge we never sent them, or replayed an
                -- answer we had stopped waiting for. That proves nothing, so any
                -- trust they already had is dropped as well: replaying an old
                -- answer must not keep a session alive.
                t.verified[from] = nil
                t.failed[from] = "answered a challenge that was never sent to them"
                return {}
            end
            t.sent[m.n], t.nSent = nil, t.nSent - 1
            if m.a == answer(m.n) then
                t.verified[from], t.failed[from] = true, nil
                if opts.onOK then opts.onOK(from) end
            else
                t.verified[from] = nil
                t.failed[from] = "wrong passphrase"
                if opts.onBad then opts.onBad(from, t.failed[from]) end
            end
            return {}
        end
        return nil
    end

    function t.drop(id) t.verified[id], t.failed[id] = nil, nil end

    function t.summary()
        local okList, badList = {}, {}
        for id in pairs(t.verified) do table.insert(okList, id) end
        for id, why in pairs(t.failed) do table.insert(badList, "#" .. tostring(id) .. " " .. why) end
        return okList, badList
    end
    return t
end

function pingMsg(from)  return base("ping", from) end
function byeMsg(from)   return base("bye", from) end

function queryMsg(from, to)
    local m = base("query", from); m.to = to; return m
end

function actMsg(from, to, side, action, label, data)
    local m = base("act", from)
    m.to = to; m.side = side; m.action = action
    if label ~= nil then m.label = label end
    if data ~= nil then m.data = data end
    return m
end

function ackMsg(from, to, ok, msg)
    local m = base("ack", from)
    m.to = to; m.ok = (ok == true); m.msg = tostring(msg or "")
    return m
end

---------------------------------------------------------------------------
-- File message constructors
---------------------------------------------------------------------------
function fstatMsg(from, to, path)  local m = base("fstat", from); m.to = to; m.path = path; return m end
function freadMsg(from, to, path)  local m = base("fread", from);  m.to = to; m.path = path; return m end
function fwipeMsg(from, to, path)  local m = base("fwipe", from);  m.to = to; m.path = path; return m end
function fdirMsg(from, to, path)   local m = base("fdir", from);   m.to = to; m.path = path; return m end
function fdelMsg(from, to, path)   local m = base("fdel", from);   m.to = to; m.path = path; return m end

function fchunkMsg(from, to, path, piece)
    local m = base("fchunk", from)
    m.to, m.path, m.i, m.part, m.sum, m.last = to, path, piece.i, piece.part, piece.sum, piece.last
    return m
end

local function fileSize(path)
    local ok, v = pcall(fs.getSize, path)
    if ok and type(v) == "number" then return v end
    return nil
end

-- Read a text file the way 1.75 allows. fs.open(path,"r") gives ONLY
-- readLine/readAll/close (FSAPI$1 in the jar), and readAll drops newlines, so
-- the file travels as a list of lines plus a `trailing` flag: the caller
-- rejoins with "\n" and puts the final newline back when the raw size says it
-- was there. That is the only faithful text round trip this version offers.
function readLines(path)
    if type(path) ~= "string" or path == "" then return nil, "no path" end
    local f, err = nil, nil
    local ok, handle = pcall(fs.open, path, "r")
    if not ok then return nil, tostring(handle) end
    if handle == nil then return nil, "no such file: " .. path end
    f = handle
    local lines, n = {}, 0
    while true do
        local okL, line = pcall(f.readLine)
        if not okL then pcall(f.close); return nil, tostring(line) end
        if line == nil then break end
        n = n + 1
        lines[n] = line
        if n >= 20000 then break end     -- bounded: a floppy cannot be walked forever
    end
    pcall(f.close)
    local joined = table.concat(lines, "\n")
    local size = fileSize(path)
    return { lines = lines, text = joined, sum = checksum(joined),
             size = size, lines_n = n,
             trailing = (type(size) == "number" and size == #joined + 1) }
end

-- Append one piece of a file. The host checks the offset against the file it has
-- in front of it, so a chunk that arrives out of order or twice is refused
-- rather than silently producing a file that is almost right.
function appendChunk(path, piece)
    if type(piece) ~= "table" or type(piece.part) ~= "string" then return false, "no piece" end
    if type(piece.sum) == "number" and piece.sum ~= checksum(piece.part) then
        return false, "piece failed its checksum before it was written"
    end
    local here = fileSize(path)
    if here == nil then
        if (piece.i or 1) ~= 1 then
            return false, "piece " .. tostring(piece.i) .. " arrived before piece 1"
        end
        here = 0
    end
    if type(piece.off) == "number" and piece.off ~= here then
        return false, "piece at " .. tostring(piece.off) .. " but the file is " .. here .. " bytes"
    end
    local ok, handle = pcall(fs.open, path, "a")
    if not ok then return false, tostring(handle) end
    if handle == nil then return false, "cannot open " .. path .. " for writing" end
    local okW, werr = pcall(handle.write, piece.part)
    pcall(handle.flush)
    pcall(handle.close)
    if not okW then return false, tostring(werr) end
    return true, "wrote " .. #piece.part .. " bytes at " .. tostring(here)
end

-- One drive record on the wire. Kept flat and small on purpose: a 40-drive host
-- has to fit in a batch.
function wireDrive(r)
    local d = {
        side     = r.side,
        hasDisk  = (r.hasDisk == true),
        hasData  = (r.hasData == true),
        mount    = r.mount,
        label    = r.label,
        diskID   = r.diskID,
        readOnly = (r.readOnly == true),
        free     = (type(r.free) == "number") and r.free or nil,
        files    = (type(r.files) == "number") and r.files or nil,
        used     = (type(r.used) == "number") and r.used or nil,
        truncated = (r.truncated == true),
    }
    if r.manifest then
        d.array  = r.manifest.array
        d.slot   = r.manifest.slot
        d.member = r.manifest.member
        d.mode   = r.manifest.mode
        d.name   = r.manifest.name
        -- the count, not the whole member list: enough to know a member is
        -- missing without shipping the array definition forty times
        d.members = (type(r.manifest.members) == "table") and #r.manifest.members
                    or r.manifest.members
    end
    return d
end

-- Split a drive list into the messages a host should send.
function hostsMsgs(from, computer, drives)
    local out, n, total = {}, 0, #drives
    local i = 1
    while i <= total or i == 1 do
        n = n + 1
        local batch = {}
        for j = i, math.min(i + BATCH - 1, total) do table.insert(batch, drives[j]) end
        local m = base("hosts", from)
        m.computer = computer
        m.seq, m.last, m.total = n, (i + BATCH > total), total
        m.drives = batch
        table.insert(out, m)
        i = i + BATCH
    end
    return out
end

---------------------------------------------------------------------------
-- Host end
---------------------------------------------------------------------------
-- serve() owns no drive data of its own: it asks a provider for current
-- records, and answers the protocol. diskarray_host.lua passes a provider that
-- reads the real drives; the tests pass one that returns a fixed list.
---------------------------------------------------------------------------
-- Reading the passphrase. It can be typed (--key) or kept in a file
-- (--key-file) so it does not sit in the shell history of a public machine.
-- A named key file that cannot be read is an ERROR, not a silent downgrade to
-- unlocked: the one failure mode this must never have is starting up open and
-- looking closed.
---------------------------------------------------------------------------
function keyFromArgs(argv)
    local phrase, file
    local i = 1
    while i <= #argv do
        local a = argv[i]
        if a == "--key" then
            phrase = tostring(argv[i + 1] or ""); i = i + 2
        elseif a == "--key-file" then
            file = tostring(argv[i + 1] or ""); i = i + 2
        else
            i = i + 1
        end
    end
    if type(file) == "string" and file ~= "" then
        -- pcall hands the handle back as its SECOND result; losing it here makes
        -- a perfectly good key file look missing (it did, in the test suite).
        local ok, handle = pcall(function() return fs.open(file, "r") end)
        if not ok then
            return nil, "cannot read --key-file " .. file .. ": " .. tostring(handle)
        end
        if not handle then
            return nil, "cannot read --key-file " .. file .. ": no such file"
        end
        local h = handle
        -- readLine, not readAll: 1.75 readAll drops the newlines
        local line = h.readLine()
        h.close()
        if type(line) == "string" then
            line = line:gsub("^%s+", ""):gsub("%s+$", "")
        end
        if line == nil or line == "" then
            return nil, "--key-file " .. file .. " holds no passphrase"
        end
        phrase = line
    end
    if phrase == "" then phrase = nil end
    return phrase, nil, file
end

-- A passphrase sitting on a floppy can be walked off with. Say so once.
function keyFileIsRemovable(file)
    if type(file) ~= "string" then return false end
    local head = string.match(file, "^([^/]+)/") or ""
    return head ~= "" and string.match(head, "^disk%d*$") ~= nil
end


function serve(opts)
    local h = {
        computer = opts.computer,
        provider = opts.provider,
        replies  = {},
    }

    local function list()
        local d = opts.provider and opts.provider() or {}
        local out = {}
        for i = 1, #d do table.insert(out, wireDrive(d[i])) end
        return out
    end

    -- A path is always "<side>/<path inside that drive>". The host refuses
    -- anything else, so a message cannot reach outside a drive the operator
    -- chose to export, and cannot name another computer's mount.
    function h.resolve(p)
        if type(p) ~= "string" or p == "" then return nil, "no path" end
        local side = string.match(p, "^([^/]+)/")
        if side == nil then return nil, "path must start with a drive side: " .. p end
        local rest = string.sub(p, #side + 2)
        if rest == "" then return nil, "no path inside the drive" end
        if rest:find("..", 1, true) then return nil, "no parent paths" end
        local rec = nil
        local list = opts.provider and opts.provider() or {}
        for i = 1, #list do if list[i].side == side then rec = list[i] break end end
        if not rec then return nil, "no such drive here: " .. side end
        if not rec.mount then return nil, side .. " has no mounted disk" end
        return rec.mount .. "/" .. rest, nil
    end

    -- What this host says when it is not answering anyone in particular. A
    -- locked host announces itself and nothing else: no side names, no labels,
    -- no free space. The layout is the part worth keeping off a shared wire.
    function h.push()
        if opts.trust and opts.trust.locked() then
            return { helloMsg(h.computer) }
        end
        return hostsMsgs(h.computer, h.computer, list())
    end

    -- Full drive list, aimed at one computer that has now proved the key.
    function h.announceTo(id)
        local msgs = hostsMsgs(h.computer, h.computer, list())
        for i = 1, #msgs do msgs[i].to = id end
        return msgs
    end

    -- Handle one inbound message. Returns the messages to send back (possibly
    -- none); the caller does the rednet sending.
    function h.onMessage(m)
        if type(m) ~= "table" or m.p ~= PROTO then return {} end
        local tr = opts.trust
        if tr and tr.locked() then
            local reps = tr.onMessage(m, m.from)
            if reps then return reps end
            if m.k ~= key() then
                return { ackMsg(h.computer, m.from, false,
                    "this host is locked - run diskarray_server.lua with the same --key") }
            end
            if not tr.ok(m.from) then
                -- they know the phrase but have not answered a challenge yet
                local out = { ackMsg(h.computer, m.from, false, "answer this challenge first") }
                local c = tr.challenge(m.from)
                if c then table.insert(out, c) end
                return out
            end
        end
        if m.v ~= VERSION then
            return { ackMsg(h.computer, m.from, false,
                            "protocol version " .. tostring(m.v) .. " not understood") }
        end
        if m.t == "ping" or m.t == "query" then
            return hostsMsgs(h.computer, h.computer, list())
        elseif m.t == "fstat" or m.t == "fread" or m.t == "fdir"
               or m.t == "fwipe" or m.t == "fchunk" or m.t == "fdel" then
            local out = {}
            local function reply(extra)
                local r = base(m.t, h.computer)
                r.id, r.to, r.path = m.id, m.from, m.path
                for k, v in pairs(extra or {}) do r[k] = v end
                table.insert(out, r)
            end
            local full, why = h.resolve(m.path)
            if not full then
                reply({ ok = false, msg = why })
                return out
            end
            if m.t == "fstat" then
                local info, e = readLines(full)
                if not info then reply({ ok = false, msg = e })
                else reply({ ok = true, size = info.size, lines = info.lines_n,
                             sum = info.sum, trailing = info.trailing }) end
            elseif m.t == "fread" then
                local info, e = readLines(full)
                if not info then reply({ ok = false, msg = e })
                else reply({ ok = true, lines = info.lines, sum = info.sum,
                             size = info.size, trailing = info.trailing }) end
            elseif m.t == "fdir" then
                local okL, names = pcall(fs.list, full)
                if not okL then reply({ ok = false, msg = tostring(names) })
                else reply({ ok = true, names = names }) end
            elseif m.t == "fwipe" then
                local okD, derr = pcall(fs.delete, full)
                -- deleting first is the only way to truncate: mode "w" would do
                -- it too, but a half-written file from a previous attempt is
                -- worse than none
                local parent = string.match(full, "^(.*)/[^/]+$") or full
                if not (pcall(fs.exists, parent) and fs.exists(parent)) then
                    pcall(fs.makeDir, parent)
                end
                local okO, handle = pcall(fs.open, full, "w")
                if not okO or handle == nil then
                    reply({ ok = false, msg = "cannot create " .. tostring(m.path)
                            .. (okO and "" or (": " .. tostring(handle))) })
                else pcall(handle.close); reply({ ok = true }) end
            elseif m.t == "fchunk" then
                local okA, msg = appendChunk(full, { i = m.i, part = m.part, sum = m.sum, last = m.last })
                reply({ ok = okA, msg = msg })
            elseif m.t == "fdel" then
                -- deleting something that is not there is not a fault; saying
                -- so keeps a cleanup pass from looking like a failure
                local exists = (pcall(fs.exists, full)) and fs.exists(full)
                if not exists then
                    reply({ ok = true, msg = "nothing there" })
                else
                    local okD, derr = pcall(fs.delete, full)
                    reply({ ok = okD, msg = okD and "deleted" or tostring(derr) })
                end
            end
            return out
        elseif m.t == "act" then
            local ok, msg = false, "unknown action"
            if opts.act then ok, msg = opts.act(m.side, m.action, m.label, m.data) end
            -- Answer, then push the new drive list: the server sees the result
            -- of its own action without waiting for the next beacon.
            local out = { ackMsg(h.computer, m.from, ok, msg) }
            if ok then
                local push = h.push()
                for i = 1, #push do table.insert(out, push[i]) end
            end
            return out
        end
        return {}
    end

    -- Same thing under a different name: a disk went in or out, or the beacon
    -- fired. One definition only, so a locked host cannot accidentally be
    -- chatty on one path and quiet on the other.
    function h.heartbeat() return h.push() end

    return h
end

---------------------------------------------------------------------------
-- Server end
---------------------------------------------------------------------------
-- listen() keeps the roster of hosts and the drive snapshots they last sent.
-- It never blocks and never talks to rednet: the entry program feeds it
-- messages and sends what it asks for.
function listen(opts)
    local s = {
        now     = (opts and type(opts.now) == "function") and opts.now or os.clock,
        timeout = (opts and tonumber(opts.timeout)) or 20,
        roster  = {},      -- computer -> { lastSeen, total, got, incomplete, drives }
        order   = {},
        events  = {},      -- human-readable notes for the UI
    }

    local function note(text) table.insert(s.events, text) end

    local function forget(computer)
        if not s.roster[computer] then return end
        s.roster[computer] = nil
        for i = 1, #s.order do
            if s.order[i] == computer then table.remove(s.order, i) break end
        end
    end

    function s.onMessage(m, sender)
        if type(m) ~= "table" or m.p ~= PROTO then return {} end
        local tr = opts.trust
        local from = sender or m.from
        if tr and tr.locked() then
            local reps = tr.onMessage(m, from)
            if reps then return reps end
            if m.k ~= key() then
                note("ignored #" .. tostring(from) .. " - wrong or missing key")
                return {}
            end
        end
        if m.v ~= VERSION then
            note("host #" .. tostring(from) .. " speaks protocol v" .. tostring(m.v)
                 .. " - update DiskArray on that computer")
            return {}
        end
        if m.t == "hello" then
            -- a locked host telling us it exists. Nothing about its drives has
            -- been said, and nothing will be believed until it answers.
            if tr and tr.locked() and not tr.ok(from) then
                local c = tr.challenge(from)
                if c then
                    note("found locked host #" .. tostring(from) .. " - challenging it")
                    return { c }
                end
            end
            return {}
        end
        if m.t == "bye" then
            if s.roster[m.computer or m.from] then
                note("host #" .. tostring(m.computer or m.from) .. " went away")
            end
            forget(m.computer or m.from)
            return {}
        elseif m.t == "ack" then
            note("host #" .. tostring(m.from) .. ": " .. (m.ok and "ok" or "failed")
                 .. (m.msg ~= "" and (" - " .. m.msg) or ""))
            return {}
        elseif m.t ~= "hosts" then
            return {}
        end

        -- A "hosts" message is a claim about drives. Unverified peers do not get
        -- to make it: their drives would show up in the UI and could be pointed
        -- at by anyone reading the roster.
        if tr and tr.locked() and not tr.ok(from) then
            note("#" .. tostring(from) .. " claimed drives without proving the key")
            local c = tr.challenge(from)
            return c and { c } or {}
        end

        local c = m.computer or m.from
        if not c then return end
        local h = s.roster[c]
        if not h then
            h = { computer = c, drives = {}, total = 0, got = 0, incomplete = false,
                  verified = (tr == nil) or tr.ok(from) }
            s.roster[c] = h
            table.insert(s.order, c)
            note("found host #" .. tostring(c))
        end
        h.verified = (tr == nil) or tr.ok(from)
        if m.seq == 1 then
            h.drives, h.got, h.incomplete = {}, 0, false
            h.total = m.total or 0
        end
        for i = 1, #(m.drives or {}) do table.insert(h.drives, m.drives[i]) end
        h.got = h.got + #(m.drives or {})
        if m.last then
            h.incomplete = (h.total or 0) ~= #h.drives
            h.lastSeen = s.now()
        end
    end

    -- Drop hosts we have stopped hearing from.
    function s.expire()
        local t, dropped = s.now(), {}
        for i = 1, #s.order do
            local c = s.order[i]
            local h = s.roster[c]
            if h and (t - (h.lastSeen or 0)) > s.timeout then
                table.insert(dropped, c)
            end
        end
        for i = 1, #dropped do
            note("lost host #" .. tostring(dropped[i]) .. " (no reply)")
            -- a host that goes quiet has to prove the key again when it returns
            if opts.trust then opts.trust.drop(dropped[i]) end
            forget(dropped[i])
        end
        return #dropped
    end

    function s.hosts()
        local out = {}
        for i = 1, #s.order do
            local h = s.roster[s.order[i]]
            if h then
                table.insert(out, { computer = h.computer, drives = h.drives,
                                    verified = h.verified ~= false,
                                    total = h.total, got = #h.drives,
                                    incomplete = h.incomplete,
                                    lastSeen = h.lastSeen,
                                    age = math.floor(s.now() - (h.lastSeen or 0)) })
            end
        end
        return out
    end

    -- Every remote drive, tagged with the computer it is on and a key that is
    -- unique across the whole network: "#7:back".
    function s.drives()
        local out = {}
        local hs = s.hosts()
        for i = 1, #hs do
            for j = 1, #hs[i].drives do
                local d = hs[i].drives[j]
                d.computer = hs[i].computer
                d.key = "#" .. hs[i].computer .. ":" .. tostring(d.side)
                table.insert(out, d)
            end
        end
        return out
    end

    function s.takeEvents()
        local e = s.events
        s.events = {}
        return e
    end

    return s
end
