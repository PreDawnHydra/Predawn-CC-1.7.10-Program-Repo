-- ===========================================================================
--  pool.lua   ->  global `pool`
-- ---------------------------------------------------------------------------
--  The disk pool: what drives are attached, what is in them, and how much room
--  the pool has. Slice 2 adds the array itself: each member floppy carries a
--  .diskarray manifest (see manifest.lua), the pool works out which array it is
--  looking at, and reports missing or duplicated members. It still does not
--  write user files or talk to other computers.
--
--  API facts this file is built on, all read out of ComputerCraft1.75.jar:
--    drive peripheral methods: isDiskPresent, getDiskLabel, setDiskLabel,
--      hasData, getMountPath, hasAudio, getAudioTitle, playAudio, stopAudio,
--      ejectDisk, getDiskID.  There is NO getSpace / isReadOnly / unmount on
--      the peripheral in this version — capacity and writability come from fs.
--    fs: combine, copy, delete, exists, find, getDir, getDrive, getFreeSpace,
--      getName, getSize, isDir, isReadOnly, list, makeDir, move, open.
--    Mount paths are probed as disk, disk2, disk3... in ATTACH order, so a
--    mount path says nothing about which physical drive it belongs to. The
--    identifiers are the peripheral side name and, for the array, the member
--    id written into the manifest — getDiskID() is the floppy item's damage
--    value and can be -1 or collide, so it is a hint, never a key.
--
--  Every loop here is bounded (MAX_WALK_* below) and every filesystem and
--  peripheral call is wrapped: fs.list raises on a missing path or a file,
--  fs.isReadOnly/fs.getFreeSpace raise on a bad path, and a drive method can
--  raise on a non-CC disk.
-- ===========================================================================

local MAX_WALK_ENTRIES = 1500   -- hard cap on entries visited per measure()
local MAX_WALK_DEPTH   = 6      -- directory depth cap

local records  = {}             -- ordered by key, for lists (local + remote)
local bySide   = {}             -- key -> record; a local key IS its side name
local localRec = {}             -- the local half of `records`, in side order
local remote   = {}             -- drive snapshots reported by remote hosts
local actFn    = nil            -- routes actions on remote drives (set by the entry)
local lastScan = 0              -- os.clock() of the last scan
local scanNote = "not scanned yet"

---------------------------------------------------------------------------
-- Guarded call helpers
---------------------------------------------------------------------------
local function call(side, method, ...)
    local ok, value = pcall(peripheral.call, side, method, ...)
    if ok then return value end
    return nil, tostring(value)
end

local function fsok(fn, ...)
    local ok, value = pcall(fn, ...)
    if ok then return value end
    return nil, tostring(value)
end

---------------------------------------------------------------------------
-- Measure what a mounted disk holds. fs has no "total size" in 1.75, so
-- capacity is reported as free + used(files), and used comes from a bounded
-- walk. `truncated` is set whenever the walk stopped early — the numbers are
-- then a floor, not the truth, and the UI says so.
---------------------------------------------------------------------------
local function measure(path)
    local used, files, truncated, seen = 0, 0, false, 0
    local queue = { { path, 0 } }
    local head = 1
    while head <= #queue do
        if seen >= MAX_WALK_ENTRIES then
            truncated = true
            break
        end
        local item = queue[head]
        head = head + 1
        local dir, depth = item[1], item[2]
        local names, err = fsok(fs.list, dir)
        if type(names) ~= "table" then
            truncated = truncated or (err ~= nil)
        else
            for i = 1, #names do
                if seen >= MAX_WALK_ENTRIES then
                    truncated = true
                    break
                end
                seen = seen + 1
                local child = fs.combine(dir, names[i])
                local isDir = fsok(fs.isDir, child)
                if isDir == true then
                    if depth < MAX_WALK_DEPTH then
                        table.insert(queue, { child, depth + 1 })
                    else
                        -- Nothing below the depth cap is counted, so the
                        -- numbers are a floor and the UI has to say so.
                        truncated = true
                    end
                else
                    local size = fsok(fs.getSize, child)
                    if type(size) == "number" then used = used + size end
                    files = files + 1
                end
            end
        end
    end
    if head <= #queue then truncated = true end
    return used, files, truncated
end

---------------------------------------------------------------------------
-- Scan
---------------------------------------------------------------------------
function scan()
    local names = {}
    local got, err = fsok(peripheral.getNames)
    if type(got) == "table" then
        for i = 1, #got do table.insert(names, got[i]) end
    elseif err then
        scanNote = "peripheral.getNames failed: " .. err
    else
        scanNote = "no peripherals"
    end
    table.sort(names)

    local fresh, freshBy = {}, {}
    for i = 1, #names do
        local side = names[i]
        local t = fsok(peripheral.getType, side)
        if t == "drive" then
            local r = { side = side, key = side, ok = true, err = nil }

            local v, e = call(side, "isDiskPresent")
            r.hasDisk = (v == true)
            if e then r.err = e end

            v, e = call(side, "hasData")
            r.hasData = (v == true)

            v, e = call(side, "getDiskLabel")
            r.label = (type(v) == "string" and v ~= "") and v or nil

            v, e = call(side, "getDiskID")
            r.diskID = v

            v, e = call(side, "hasAudio")
            r.hasAudio = (v == true)

            v, e = call(side, "getMountPath")
            r.mount = (type(v) == "string" and v ~= "") and v or nil

            if r.mount then
                r.readOnly = (fsok(fs.isReadOnly, r.mount) == true)
                local free = fsok(fs.getFreeSpace, r.mount)
                r.free = (type(free) == "number") and free or nil
                local used, files, trunc = measure(r.mount)
                r.used, r.files, r.truncated = used, files, trunc
                if type(r.free) == "number" then
                    -- An estimate, not a fact: 1.75 exposes no total size.
                    r.capacity = r.free + used
                end

                -- Array membership lives on the disk, not on the computer.
                local man, merr = manifest.read(r.mount)
                r.manifest = man
                r.manifestErr = man and nil or merr
                if man then
                    r.array, r.slot = man.array, man.slot
                    r.member, r.mode = man.member, man.mode
                    r.name = man.name
                    -- the count, so the array maths does not have to care
                    -- whether this record came from a file or a modem
                    man.membersCount = (type(man.members) == "table") and #man.members or 0
                end
            end

            table.insert(fresh, r)
            freshBy[side] = r
        end
    end

    localRec = fresh

    -- Merge in what the remote hosts last told us. A remote record is a
    -- snapshot, not a handle: it carries the same fields, minus anything that
    -- would need the other computer to answer (see net.lua).
    for i = 1, #remote do
        local d = remote[i]
        table.insert(fresh, d)
        freshBy[d.key] = d
    end

    records, bySide = fresh, freshBy
    lastScan = os.clock()
    if #records == 0 then
        scanNote = "no drives anywhere"
    else
        scanNote = #localRec .. " local"
            .. (#remote > 0 and (", " .. #remote .. " remote") or "")
    end
    return records
end

---------------------------------------------------------------------------
-- Remote drives
---------------------------------------------------------------------------
-- Feed in the drive snapshots a server got from its hosts (net.listen():drives()
-- produces these). Nothing here talks to rednet: the entry program does the
-- sending and hands the result over.
function setRemote(list)
    remote = {}
    for i = 1, #(list or {}) do
        local d = list[i]
        local r = {
            key      = d.key or (("#" .. tostring(d.computer) .. ":" .. tostring(d.side))),
            side     = d.side,
            computer = d.computer,
            ok       = true,
            hasDisk  = (d.hasDisk == true),
            hasData  = (d.hasData == true),
            mount    = d.mount,
            label    = d.label,
            diskID   = d.diskID,
            readOnly = (d.readOnly == true),
            free     = (type(d.free) == "number") and d.free or nil,
            files    = d.files,
            used     = d.used,
            truncated = (d.truncated == true),
            remote   = true,
        }
        if r.free ~= nil and type(r.used) == "number" then r.capacity = r.free + r.used end
        if d.array then
            r.manifest = { array = d.array, slot = d.slot, member = d.member,
                           mode = d.mode, name = d.name,
                           membersCount = tonumber(d.members) or 0 }
            r.array, r.slot = d.array, d.slot
            r.member, r.mode = d.member, d.mode
            r.name = d.name
        else
            r.manifestErr = r.mount and "no manifest on this disk" or nil
        end
        table.insert(remote, r)
    end
    return #remote
end

function remoteCount() return #remote end

-- The entry program installs the route for acting on a remote drive:
-- fn(record, action, label) -> ok, msg. Without it, remote drives are visible
-- but deliberately inert, which is better than pretending an eject happened.
function setActFn(f) actFn = (type(f) == "function") and f or nil end

-- The entry program hands the UI a way to describe its hosts (who answers for
-- the drives behind a modem). pool itself never talks to rednet.
local netInfoFn = nil
function setNetInfo(f) netInfoFn = (type(f) == "function") and f or nil end
function netInfo()
    if netInfoFn == nil then return {} end
    local ok, list = pcall(netInfoFn)
    if ok and type(list) == "table" then return list end
    return {}
end

function drives()  return records end
function get(side) return bySide[side] end
function count()   return #records end

function lastScanNote() return scanNote end
function age()          return os.clock() - lastScan end

---------------------------------------------------------------------------
-- Pool totals
---------------------------------------------------------------------------
function summary()
    local s = { drives = #records, disks = 0, data = 0, writable = 0,
                totalFree = 0, minFree = nil, maxFree = 0,
                used = 0, files = 0, truncated = false, unknownFree = 0 }
    for i = 1, #records do
        local r = records[i]
        if r.hasDisk then s.disks = s.disks + 1 end
        if r.hasData then s.data = s.data + 1 end
        if r.mount and r.readOnly ~= true then s.writable = s.writable + 1 end
        if r.truncated then s.truncated = true end
        if type(r.free) == "number" then
            s.totalFree = s.totalFree + r.free
            if s.minFree == nil or r.free < s.minFree then s.minFree = r.free end
            if r.free > s.maxFree then s.maxFree = r.free end
        else
            s.unknownFree = s.unknownFree + 1
        end
        if type(r.used) == "number" then s.used = s.used + r.used end
        if type(r.files) == "number" then s.files = s.files + r.files end
    end
    return s
end

---------------------------------------------------------------------------
-- The array: which array these disks belong to, and whether it is whole
---------------------------------------------------------------------------
-- Group every manifested drive by array id. Shared by arraySummary() (the one
-- array this view cares about) and arrays() (every array on the network).
local function grouped()
    local groups, order = {}, {}
    local unmanifested, unreadable = 0, 0
    for i = 1, #records do
        local r = records[i]
        if r.mount then
            if r.manifest then
                local g = groups[r.array]
                if not g then
                    g = { id = r.array, name = r.name, mode = r.mode, present = 0,
                          slots = {}, seen = {}, list = {}, members = 0, dupes = 0,
                          free = 0, used = 0, minFree = nil, minCap = nil }
                    groups[r.array] = g
                    table.insert(order, r.array)
                end
                g.present = g.present + 1
                if g.seen[r.member] then g.dupes = g.dupes + 1 end
                g.seen[r.member] = true
                g.slots[r.slot] = (g.slots[r.slot] or 0) + 1
                table.insert(g.list, r)
                if type(r.free) == "number" then
                    g.free = g.free + r.free
                    local u = (type(r.used) == "number") and r.used or 0
                    g.used = g.used + u
                    if g.minFree == nil or r.free < g.minFree then g.minFree = r.free end
                    if g.minCap == nil or r.free + u < g.minCap then g.minCap = r.free + u end
                end
                local n = tonumber(r.manifest.membersCount) or 0
                if n == 0 and type(r.manifest.members) == "table" then
                    n = #r.manifest.members
                end
                if n > g.members then
                    g.members = n
                    g.name = r.manifest.name or g.name
                end
            elseif r.manifestErr == "no manifest on this disk" then
                unmanifested = unmanifested + 1
            else
                -- a manifest that is there but unreadable is its own problem
                unreadable = unreadable + 1
            end
        end
    end
    return groups, order, unmanifested, unreadable
end

local function holes(g)
    local out = {}
    for slot = 1, g.members do
        if not g.slots[slot] then table.insert(out, slot) end
    end
    return out
end

local function stateOf(g)
    if #holes(g) > 0 then return "degraded" end
    if g.dupes > 0 then return "duplicate" end
    return "ok"
end

-- arraySummary(onlyID) - with an id, that array; without it, the array with the
-- most members present (ties break on the id so the answer never flickers).
function arraySummary(onlyID)
    local groups, order, unmanifested, unreadable = grouped()
    local best = nil
    if onlyID then
        best = groups[onlyID]
    else
        for i = 1, #order do
            local g = groups[order[i]]
            if not best or g.present > best.present
               or (g.present == best.present and g.id < best.id) then best = g end
        end
    end

    local s = { id = best and best.id or nil,
                name = best and best.name or nil,
                mode = best and best.mode or nil,
                present = best and best.present or 0,
                expected = best and best.members or 0,
                dupes = best and best.dupes or 0,
                free = best and best.free or 0,
                used = best and best.used or 0,
                missing = {},
                members = {},
                arrays = #order,
                unmanifested = unmanifested,
                unreadable = unreadable }
    if best then
        s.capacity, s.poolFree, s.poolUsed = capacityOf(best)
        s.missing = holes(best)
        for i = 1, #best.list do table.insert(s.members, best.list[i]) end
        s.state = stateOf(best)
    else
        s.capacity, s.poolFree, s.poolUsed = 0, 0, 0
        s.state = "none"
    end
    return s
end

-- Every array visible from here, biggest first. This is what lets one server
-- look after several arrays across several computers.
---------------------------------------------------------------------------
-- What a pool can actually hold, which is NOT simply the sum of its disks.
-- A mirror writes every file to every member, so the pool is only as big as
-- its SMALLEST disk; plain (and span, when it exists) can use the whole sum.
-- Showing the sum for a mirror would promise space that cannot be used.
---------------------------------------------------------------------------
function capacityOf(g)
    if g.mode == "mirror" then
        local cap = g.minCap or 0
        local free = g.minFree or 0
        return cap, free, cap - free
    end
    local free = g.free or 0
    local used = g.used or 0
    return free + used, free, used
end

function arrays()
    local groups, order = grouped()
    local out = {}
    for i = 1, #order do
        local g = groups[order[i]]
        table.insert(out, { id = g.id, name = g.name, mode = g.mode,
                            present = g.present, expected = g.members,
                            missing = holes(g), dupes = g.dupes, free = g.free,
                            used = g.used, state = stateOf(g), members = g.list })
        local cap, free, used = capacityOf(g)
        out[#out].capacity, out[#out].poolFree, out[#out].poolUsed = cap, free, used
    end
    table.sort(out, function(a, b)
        if a.expected ~= b.expected then return a.expected > b.expected end
        return a.id < b.id
    end)
    return out
end

---------------------------------------------------------------------------
-- Write a manifest to every writable mounted disk. Slots are STICKY: a disk
-- that is already a member keeps its slot and member id, and a fresh disk takes
-- the lowest free slot. Renumbering looks harmless today (mode "plain" places
-- no data), but once chunks are placed by slot it would scramble the array, so
-- the rule is set now. Side-name order only decides the slots of a first,
-- empty array.
---------------------------------------------------------------------------
-- Which slot each drive would take. Slots already held by a member of this
-- array are kept; free slots go to the newcomers, lowest first. initArray() and
-- the Builder's preview both call this, so a preview cannot disagree with what
-- the write will actually do.
---------------------------------------------------------------------------
function planSlots(arrayID, keys)
    local asked = {}
    for i = 1, #(keys or {}) do asked[keys[i]] = true end

    local taken, maxSlot = {}, 0
    for i = 1, #records do
        local r = records[i]
        if not asked[r.key] and r.manifest and r.manifest.array == arrayID then
            local s = tonumber(r.manifest.slot)
            if s and s > 0 and not taken[s] then
                taken[s] = true
                if s > maxSlot then maxSlot = s end
            end
        end
    end

    -- Two passes, and the order matters: every existing member claims its own
    -- slot BEFORE any newcomer takes a free one. Doing it in one pass lets a
    -- newcomer that happens to be earlier in the list steal a member's slot and
    -- renumber it, which is exactly the bug this whole routine exists to stop.
    local slotOf, kept = {}, 0
    for i = 1, #(keys or {}) do
        local key = keys[i]
        local r = bySide[key]
        if r and r.manifest and r.manifest.array == arrayID then
            local s = tonumber(r.manifest.slot)
            if s and s > 0 and not taken[s] then
                slotOf[key], kept = s, kept + 1
                taken[s] = true
                if s > maxSlot then maxSlot = s end
            end
        end
    end
    for i = 1, #(keys or {}) do
        local key = keys[i]
        if slotOf[key] == nil then
            local n = 1
            while taken[n] do n = n + 1 end
            slotOf[key] = n
            taken[n] = true
            if n > maxSlot then maxSlot = n end
        end
    end
    local out = {}
    for i = 1, #(keys or {}) do
        table.insert(out, { key = keys[i], slot = slotOf[keys[i]] })
    end
    return out, kept, maxSlot
end

---------------------------------------------------------------------------
-- initArray(mode, keys, name)
--   keys  optional list of drive KEYS to enrol; without it every writable
--         mounted disk is enrolled (the broad sweep the Builder replaces)
--   name  optional human name stored in the manifest
-- A remote disk is written through the network route the entry program
-- installed; with no route installed a remote disk is reported as skipped
-- rather than pretending the write happened.
function initArray(mode, keys, name, forceID)
    local want = nil
    if type(keys) == "table" then
        want = {}
        for i = 1, #keys do want[keys[i]] = true end
    end

    local targets, skipped = {}, {}
    for i = 1, #records do
        local r = records[i]
        if want and not want[r.key] then
            -- not asked for: nobody touches it
        elseif r.mount and r.readOnly ~= true then
            table.insert(targets, r)
        elseif r.mount then
            -- say why the array came out smaller than the drives attached
            table.insert(skipped, r.key .. " read-only")
        elseif want then
            table.insert(skipped, r.key .. " has no mounted disk")
        end
    end
    if #targets == 0 then return false, "no writable mounted disk to initialise" end

    -- keep the array already on the disks; only a fresh set gets a new id
    local arrayID = nil
    for i = 1, #targets do
        local r = targets[i]
        if r.manifest and r.manifest.array then arrayID = r.manifest.array break end
    end
    if not arrayID and forceID then arrayID = forceID end
    if not arrayID then
        for i = 1, #records do
            local r = records[i]
            if r.manifest and r.manifest.array then arrayID = r.manifest.array break end
        end
    end
    if not arrayID then arrayID = manifest.newArrayID() end

    local keysOf = {}
    for i = 1, #targets do table.insert(keysOf, targets[i].key) end
    local slots, kept, maxSlot = planSlots(arrayID, keysOf)
    local plan = {}
    for i = 1, #slots do
        table.insert(plan, { r = bySide[slots[i].key], slot = slots[i].slot })
    end

    -- The member list is replicated on every disk, so any one disk can say what
    -- the array should look like when it is whole.
    local members = {}
    for s = 1, maxSlot do members[s] = manifest.memberID(arrayID, s) end

    local written, failed = 0, {}
    for i = 1, #plan do
        local p = plan[i]
        local ok, msg = writeManifest(p.r, manifest.build(arrayID, p.slot, members,
                                                          mode or "plain", name))
        if ok then written = written + 1
        else table.insert(failed, p.r.key .. ": " .. tostring(msg)) end
    end
    scan()
    if written == 0 then return false, "wrote nothing (" .. table.concat(failed, "; ") .. ")" end
    for i = 1, #skipped do table.insert(failed, skipped[i]) end
    local msg = "initialised " .. written .. " disk(s) as " .. arrayID
        .. " (" .. kept .. " kept, " .. (written - kept) .. " joined)"
    if #failed > 0 then msg = msg .. ", skipped " .. table.concat(failed, "; ") end
    return true, msg
end

---------------------------------------------------------------------------
-- Writing a manifest, locally or through a host
---------------------------------------------------------------------------
function writeManifest(r, t)
    if r.remote ~= true then
        if not r.mount then return false, tostring(r.key) .. " has no mounted disk" end
        return manifest.write(r.mount, t)
    end
    if actFn == nil then return false, "remote drive " .. tostring(r.key) .. ": no network route" end
    local ok, msg = actFn(r, "manifest", nil, t)
    return (ok == true), tostring(msg)
end

function dropManifest(r)
    if r.remote ~= true then
        if not r.mount then return false, tostring(r.key) .. " has no mounted disk" end
        return manifest.clear(r.mount)
    end
    if actFn == nil then return false, "remote drive " .. tostring(r.key) .. ": no network route" end
    local ok, msg = actFn(r, "unmanifest")
    return (ok == true), tostring(msg)
end

function clearManifest(key)
    local r = bySide[key]
    if not r then return false, "no such drive: " .. tostring(key) end
    if not r.mount then return false, tostring(key) .. " has no mounted disk" end
    local ok, msg = dropManifest(r)
    scan()
    return ok, msg
end

---------------------------------------------------------------------------
-- Actions. Every one takes a drive KEY: a side name for a local drive, or
-- "#7:back" for one behind a modem.
---------------------------------------------------------------------------
function eject(key)
    local r = bySide[key]
    if not r then return false, "no such drive: " .. tostring(key) end
    if r.remote == true then
        if actFn == nil then return false, "remote drive " .. key .. ": no network route" end
        local ok, msg = actFn(r, "eject")
        scan()
        return (ok == true), tostring(msg)
    end
    local ok, err = pcall(peripheral.call, r.side, "ejectDisk")
    scan()
    if not ok then return false, tostring(err) end
    return true, "ejected " .. key
end

function setLabel(key, label)
    local r = bySide[key]
    if not r then return false, "no such drive: " .. tostring(key) end
    if type(label) ~= "string" or label == "" then return false, "label must be text" end
    if r.remote == true then
        if actFn == nil then return false, "remote drive " .. key .. ": no network route" end
        local ok, msg = actFn(r, "label", label)
        scan()
        return (ok == true), tostring(msg)
    end
    local ok, err = pcall(peripheral.call, r.side, "setDiskLabel", label)
    scan()
    if not ok then return false, tostring(err) end
    return true, "labelled " .. key
end

---------------------------------------------------------------------------
-- Events: the drive peripheral queues "disk" and "disk_eject" with the drive
-- name, so a scan on those is what keeps the pool honest when someone walks up
-- and swaps a floppy. Breaking the drive block itself fires neither - it fires
-- peripheral_detach - and that has to refresh the pool too, otherwise a pulled
-- drive looks fine for up to a refresh interval.
---------------------------------------------------------------------------
function isPoolEvent(event)
    return event == "disk" or event == "disk_eject"
        or event == "peripheral_attach" or event == "peripheral_detach"
end

---------------------------------------------------------------------------
-- Formatting
---------------------------------------------------------------------------
function bytes(n)
    if type(n) ~= "number" then return "?" end
    if n >= 1000000 then return (math.floor(n / 100000) / 10) .. "MB" end
    if n >= 1000   then return (math.floor(n / 100) / 10) .. "KB" end
    return n .. "B"
end
