local function deviceItems()
    local out = {}
    local recs = sortedDrives()
    for i = 1, #recs do
        local r = recs[i]
        local ok, why = builder.usable(r)
        table.insert(out, {
            key    = r.key,
            label  = r.label,
            usable = ok,
            why    = r.manifest and ("array " .. tostring(r.slot)) or why,
            member = r.manifest ~= nil,
            where  = r.computer and ("host #" .. r.computer) or "local",
            free   = r.free,
        })
    end
    return out
end

local function renderDeviceRow(s, x, y, w, it, idx, sel)
    local bg = sel and theme.c("selection") or theme.c("panel")
    local mark, role
    if it.member then
        mark, role = "[#]", "dim"
    elseif picked[it.key] then
        mark, role = "[x]", "ok"
    elseif it.usable then
        mark, role = "[ ]", "text"
    else
        mark, role = "[-]", "warn"
    end
    widget.text(s, x + 1, y, mark, theme.c(role), bg)
    local name = (it.label ~= nil and it.label ~= "") and it.label or "-"
    local rest = string.format(" %-14s %-10s %-9s %s", it.key, name, it.where, it.why)
    widget.text(s, x + 8, y, widget.clip(rest, math.max(w - 8, 8)),
        sel and theme.c("onAccent") or theme.c("text"), bg)
end

local function builderDevices(app, root, b, y, h)
    local listH = math.max(h - 3, 3)
    root:add(widgets.panel({ x = b.x, y = y, w = b.w, h = listH + 2,
                             title = "DRIVES  (click to select for a new array)" }))
    local lst = widgets.list({
        x = b.x + 1, y = y + 1, w = b.w - 2, h = listH,
        items = deviceItems,
        render = renderDeviceRow,
        empty = "(no drives: attach a Disk Drive, or run diskarray_host.lua elsewhere)",
        onSelect = function(it)
            selKey = it.key
            local ok, msg = togglePick(it.key)
            app.notify(msg, ok and "ok" or "warn")
            app.rebuild()
        end,
    })
    root:add(lst)
    app.defaultKey = lst

    local keys = pickedKeys()
    local remote = 0
    for i = 1, #keys do
        local r = pool.get(keys[i])
        if r and r.computer then remote = remote + 1 end
    end
    root:add(widgets.label({
        x = b.x + 1, y = y + listH + 1, w = b.w - 2,
        value = #keys .. " selected (" .. (#keys - remote) .. " local, " .. remote
                .. " remote)   [#] = already in an array",
        role = "dim",
    }))
end

