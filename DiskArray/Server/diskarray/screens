-- Arrays: one pool per row with a capacity bar, and entering a pool to see its
-- members and the files it holds. A pool's bar is mode-aware: a mirror is only
-- as big as its smallest disk, so the bar says what you can actually use.
---------------------------------------------------------------------------
local function poolStatsLine(a)
    return "used " .. pool.bytes(a.poolUsed or 0)
        .. "  free " .. pool.bytes(a.poolFree or 0)
        .. "  of " .. pool.bytes(a.capacity or 0)
        .. "   members " .. a.present .. "/" .. a.expected
        .. (a.mode == "mirror" and "   (mirror: smallest disk)" or "")
end

local function poolItems()
    local out = {}
    local all = pool.arrays()
    for i = 1, #all do
        local a = all[i]
        local role = (a.state == "ok") and "ok"
                     or (a.state == "degraded" and "warn" or "error")
        out[#out + 1] = {
            kind = "name", id = a.id, array = a, role = role,
            text = " " .. tostring(a.name or a.id)
                 .. "  " .. tostring(a.mode)
                 .. "  " .. a.present .. "/" .. a.expected .. " " .. a.state
                 .. (a.dupes > 0 and "  DUPLICATE" or ""),
        }
        out[#out + 1] = {
            kind = "bar", id = a.id, array = a,
            cap = a.capacity or 0, used = a.poolUsed or 0,
            text = "",
        }
    end
    return out
end

-- Two rows per pool: the name line, then the meter. The meter is drawn rather
-- than a text approximation, because 1.75's font has no block glyphs.
local function renderPoolRow(s, x, y, w, it, idx, sel)
    local bg = sel and theme.c("selection") or theme.c("panel")
    if it.kind == "bar" then
        local barW = math.max(w - 2, 1)
        widget.fill(s, x + 1, y, barW, 1, theme.c("barTrack"))
        local filled = 0
        if it.cap > 0 then filled = math.floor((it.used / it.cap) * barW + 0.5) end
        if filled > 0 then
            widget.fill(s, x + 1, y, math.min(filled, barW), 1, theme.c("bar"))
        end
        local tag = pool.bytes(it.used) .. " / " .. pool.bytes(it.cap)
        if #tag + 2 < barW then
            widget.text(s, x + 2, y, tag, theme.c("dim"), theme.c("barTrack"))
        end
        return
    end
    widget.text(s, x + 1, y, widget.clip(it.text, w - 2), theme.c(it.role), bg)
end

local function memberItems2(arrayID)
    local a = pool.arraySummary(arrayID)
    local out = {}
    for i = 1, #a.members do
        local r = a.members[i]
        out[#out + 1] = { kind = "member", key = r.key,
            text = " slot " .. string.format("%-3s", tostring(r.slot))
                 .. " " .. string.format("%-14s", widget.clip(r.key, 14))
                 .. " " .. string.format("%-16s", widget.clip(driveName(r), 16))
                 .. " " .. string.format("%8s", pool.bytes(r.free or 0)) .. " free"
                 .. (r.remote == true and "  net" or "") }
    end
    for i = 1, #a.missing do
        out[#out + 1] = { kind = "hole", slot = a.missing[i],
                          text = " slot " .. string.format("%-3s", tostring(a.missing[i]))
                               .. " " .. string.rep(" ", 14)
                               .. "   -- MISSING --   a disk can join it in the Builder" }
    end
    return out
end

local function buildArrays(app, root)
    local b = app.body()
    if inArray == nil or pool.arraySummary(inArray).id == nil then
        if inArray ~= nil then inArray = nil end   -- the pool is gone from the network
        local all = pool.arrays()
        local totFree, totMembers = 0, 0
        for i = 1, #all do totFree = totFree + (all[i].poolFree or 0)
                            totMembers = totMembers + all[i].present end
        root:add(widgets.label({
            x = b.x, y = b.y, w = b.w, h = 1,
            value = "POOLS  " .. #all .. "   members " .. totMembers
                 .. "   free " .. pool.bytes(totFree), role = "dim",
        }))
        local lh = math.max(1, b.h - 3)
        local list = widgets.list({
            x = b.x, y = b.y + 1, w = b.w, h = lh,
            items = function() return poolItems() end,
            render = renderPoolRow,
            empty = "(no pools yet - the Builder tab makes one)",
            onSelect = function(it)
                inArray = it.id
                selArray = it.id
                selFile, armDelete = nil, nil
                app.notify("opened " .. tostring((function()
                    local a2 = pool.arraySummary(it.id)
                    return a2.name or a2.id
                end)()), "dim")
                app.rebuild()
            end,
        })
        root:add(list)
        app.defaultKey = list
        buttonRow(app, root, b.y + b.h - 1, actionDefs(app, { "rescan", "tobuilder" }))
        return
    end

    ------------------------------ one pool, opened ------------------------------
    local a = pool.arraySummary(inArray)
    local y = b.y
    root:add(widgets.label({
        x = b.x, y = y, w = b.w, h = 1, role = "accent",
        value = tostring(a.name or a.id) .. "   " .. tostring(a.id)
             .. "   " .. tostring(a.mode) .. "   " .. a.state,
    }))
    y = y + 1
    root:add(widgets.progress({
        x = b.x, y = y, w = b.w, h = 1,
        value = function() return pool.arraySummary(inArray).poolUsed or 0 end,
        max   = function() local c = pool.arraySummary(inArray).capacity or 0
                           return c > 0 and c or 1 end,
    }))
    y = y + 1
    root:add(widgets.label({ x = b.x, y = y, w = b.w, h = 1, role = "dim",
                             value = poolStatsLine(a) }))
    y = y + 1

    -- Members above, files below; both lists shrink to fit the screen.
    local rows = b.h - (y - b.y) - 1        -- leave the button row
    local filesH  = math.max(3, math.floor(rows * 0.45))
    local membersH = math.max(2, rows - filesH - 4)
    root:add(widgets.panel({ x = b.x, y = y, w = b.w, h = membersH + 2,
                             title = "MEMBERS  " .. a.present .. "/" .. a.expected }))
    local lm = widgets.list({
        x = b.x + 1, y = y + 1, w = b.w - 2, h = membersH,
        items = function() return memberItems2(inArray) end,
        render = renderArrayRow,
        empty = "(no members present)",
        onSelect = function(it)
            if it.kind == "hole" then
                app.notify("slot " .. tostring(it.slot) .. " is empty - the Builder can join a disk", "warn")
            else
                app.notify("selected " .. it.key, "dim")
            end
        end,
    })
    root:add(lm)
    y = y + membersH + 2

    root:add(widgets.panel({ x = b.x, y = y, w = b.w, h = filesH + 2,
                             title = "FILES  (" .. tostring(a.mode) .. ")" }))
    local lf = widgets.list({
        x = b.x + 1, y = y + 1, w = b.w - 2, h = filesH,
        items = function() return fileItems(inArray) end,
        render = renderFileRow,
        empty = "(this pool holds no files yet)",
        onSelect = function(it)
            selFile = it.name
            armDelete = nil
            app.notify("selected " .. it.name .. " - " .. #it.members .. " copy(ies)", "dim")
            app.rebuild()
        end,
    })
    root:add(lf)
    app.defaultKey = lf
    -- one row below the panel: at +1 the field sat on top of the panel's
    -- bottom border and both looked broken
    local fieldY = y + filesH + 2
    if fieldY < b.y + b.h - 1 then
        -- Enter puts a short note in the pool. Longer files go through
        -- files.put from lua, where you can supply the text properly.
        root:add(widgets.field({
            x = b.x + 1, y = fieldY, w = b.w - 2, h = 1,
            placeholder = "type a short note, press enter to save it in this pool",
            onEnter = function(line)
                local name = "note" .. tostring(math.floor(os.clock()))
                local ok, msg = files.put(name, line, inArray)
                app.notify(msg, ok and "ok" or "error")
                app.rebuild()
            end,
        }))
    end
    -- Four, not five: five buttons on a 51-wide screen clip to "Get s" and
    -- "Delet", which is not a control you can read. Refreshing is not needed
    -- here - drive events and the periodic rescan already keep the pool live,
    -- and both lists re-read their rows at draw time.
    buttonRow(app, root, b.y + b.h - 1,
              actionDefs(app, { "back", "getfile", "delfile", "torepair" }))
end

function build(app)
    registerActions(app)
    registerBuilderActions(app)
    app.registerScreen("overview", "Overview", buildOverview)
    app.registerScreen("drives",   "Drives",   buildDrives)
    app.registerScreen("builder",  "Builder",  buildBuilder)
    app.registerScreen("arrays",   "Arrays",   buildArrays)
end
