-- ===========================================================================
--  screens.lua   ->  global `screens`      (DISKARRAY SERVER)
-- ---------------------------------------------------------------------------
--  Two clickable screens over the pool:
--    Overview — pool totals plus a capacity bar per drive
--    Drives   — pick a drive, see its detail, rescan or eject it
--
--  Everything is drawn from live pool records, and every control is a widget,
--  so mouse_click on the computer terminal and monitor_touch on a monitor both
--  hit the same handlers. Every button acts on a single click.
-- ===========================================================================

local selectedSide = nil

---------------------------------------------------------------------------
-- Selection survives a rescan: the side name is the key, and a drive can
-- disappear between scans.
---------------------------------------------------------------------------
local function selectedDrive()
    if selectedSide then return pool.get(selectedSide) end
    return nil
end

local function keepSelection()
    if selectedSide and not pool.get(selectedSide) then selectedSide = nil end
end

-- How a drive is named in the UI: its floppy label, or a clear placeholder when
-- the floppy has none. Never the mount path - that says nothing to a player.
local function driveName(d)
    if d.label ~= nil and d.label ~= "" then return d.label end
    return "(no label)"
end

---------------------------------------------------------------------------
-- Shared actions
---------------------------------------------------------------------------
local function doRescan(app)
    pool.scan()
    keepSelection()
    -- Rebuild so the view follows the scan: which drives exist, and which
    -- conditional rows apply, is decided when the screen is built.
    app.rebuild()
    app.notify("rescanned: " .. pool.lastScanNote(), "dim")
end

-- One click, like every other button. Ejecting a floppy is not treated as
-- destructive here: the disk comes back out into the player's hand and goes
-- straight back in, so a confirm step costs a click and protects nothing.
local function doEject(app)
    local d = selectedDrive()
    if not d then app.notify("select a drive to eject first", "warn") return end
    if not d.hasDisk then app.notify(d.side .. " has no disk in it", "warn") return end
    local ok, msg = pool.eject(d.side)
    keepSelection()
    app.notify(msg, ok and "ok" or "error")
    app.rebuild()
end

-- Take one disk out of the array: removes its manifest, leaves the files alone.
local function doForget(app)
    local d = selectedDrive()
    if not d then app.notify("select a drive first", "warn") return end
    if not d.mount then app.notify(d.side .. " has no mounted disk", "warn") return end
    if not d.manifest then app.notify(d.side .. " is not a member of an array", "warn") return end
    local ok, msg = pool.clearManifest(d.side)
    keepSelection()
    app.notify(msg, ok and "ok" or "error")
    app.rebuild()
end

local function registerActions(app)
    app.registerAction("rescan", { label = "Rescan", style = "primary",
                                   run = function() doRescan(app) end })
    app.registerAction("eject",  { label = "Eject", style = "danger",
                                   run = function() doEject(app) end })
    app.registerAction("forget", { label = "Forget", style = "danger",
                                   run = function() doForget(app) end })
end

---------------------------------------------------------------------------
-- Button row helper (same shape MineSwarm uses: equal chips, one gap apart)
---------------------------------------------------------------------------
-- Size buttons to their labels when they fit. Dividing the row evenly is what
-- made "Get selected" read as "Get s" on a 51-wide screen: a clipped control is
-- not a control. Only fall back to even widths when the labels genuinely do not
-- fit, which is a narrow-monitor problem and not solvable by layout alone.
local function buttonRow(app, root, y, defs)
    local b = app.body()
    local n = #defs
    if n == 0 then return end
    local gap = 1
    local widths, need = {}, 0
    for i = 1, n do
        widths[i] = math.max(6, #(defs[i].label or "") + 2)
        need = need + widths[i] + (i > 1 and gap or 0)
    end
    if need > b.w then
        local bw = math.max(math.min(math.floor((b.w - (n - 1) * gap) / n), 20), 6)
        for i = 1, n do widths[i] = bw end
    end
    local x = b.x
    for i = 1, n do
        local d = defs[i]
        root:add(widgets.button({
            x = x, y = y, w = widths[i], h = 1,
            label = d.label, action = d.run, style = d.style or "normal",
        }))
        x = x + widths[i] + gap
    end
end

local function actionDefs(app, ids)
    local defs = {}
    for i = 1, #ids do
        local act = app.actions[ids[i]]
        if act then
            table.insert(defs, { label = act.label, style = act.style,
                                 run = function() app.runAction(ids[i]) end })
        end
    end
    return defs
end

---------------------------------------------------------------------------
-- Overview
---------------------------------------------------------------------------
local function buildOverview(app, root)
    local b = app.body()
    -- Values are read when a row is DRAWN, not when the screen is built. They
    -- were built once before, which is why a Rescan left the numbers stale until
    -- the player switched screens. summary() and arraySummary() only walk a
    -- handful of drives, so calling them per row costs nothing.
    local function S() return pool.summary() end
    local function A() return pool.arraySummary() end

    local rows = {}
    -- Array identity first: if the terminal is too short to show everything, the
    -- rows that get dropped are the pool totals at the bottom, never the
    -- warnings about the array itself.
    local head = {
        { "array",     function() return A().id or "not initialised" end,
          function() return A().id and "text" or "warn" end },
        { "members",   function()
              local a2 = A()
              return a2.id and (a2.present .. "/" .. a2.expected) or "-"
          end,
          function()
              local a2 = A()
              return (a2.id and #a2.missing == 0) and "ok" or "error"
          end },
        { "state",     function()
              local a2 = A()
              return a2.state .. (a2.mode and (" (" .. a2.mode .. ")") or "")
          end,
          function()
              local st = A().state
              return st == "ok" and "ok" or (st == "none" and "dim" or "error")
          end },
    }
    local tail = {
        { "drives", function() return tostring(S().drives) end,
          function() return S().drives > 0 and "text" or "warn" end },
        { "disks in",  function() return tostring(S().disks) end, "text" },
        { "mounted",   function() return tostring(S().data) end, "text" },
        { "writable",  function() return tostring(S().writable) end,
          function() return S().writable > 0 and "ok" or "warn" end },
        { "free total", function() return pool.bytes(S().totalFree) end, "ok" },
        { "smallest free", function()
              local s = S()
              return s.minFree == nil and "? (" .. s.unknownFree .. " unreadable)" or pool.bytes(s.minFree)
          end,
          function() return (S().minFree or 0) > 0 and "text" or "error" end },
        { "files",     function() return tostring(S().files) end, "dim" },
        { "used (files)", function() return pool.bytes(S().used) end, "dim" },
        { "last scan", function() return math.floor(pool.age()) .. "s ago: " .. pool.lastScanNote() end, "dim" },
        { "hosts", function()
              local hs = pool.netInfo()
              if #hs == 0 then return "none (this computer only)" end
              local out = {}
              for i = 1, #hs do
                  table.insert(out, "#" .. hs[i].computer .. " " .. hs[i].got .. "d " .. hs[i].age .. "s")
              end
              return table.concat(out, "  ")
          end, "dim" },
    }

    -- Whether these rows exist at all is decided when the screen is built (a
    -- rebuild follows the scan); their contents stay live.
    local a2 = pool.arraySummary()
    if #a2.missing > 0 then
        table.insert(head, { "missing slots", function() return table.concat(A().missing, ",") end, "error" })
    end
    if a2.dupes > 0 then
        table.insert(head, { "duplicate members", function() return tostring(A().dupes) end, "warn" })
    end
    if a2.unmanifested > 0 then
        table.insert(head, { "disks no manifest", function() return tostring(A().unmanifested) end, "warn" })
    end
    if a2.unreadable > 0 then
        table.insert(head, { "bad manifests", function() return tostring(A().unreadable) end, "error" })
    end
    if a2.arrays > 1 then
        table.insert(head, { "other arrays", function() return tostring(A().arrays - 1) end, "warn" })
    end
    for i = 1, #head do table.insert(rows, head[i]) end
    for i = 1, #tail do table.insert(rows, tail[i]) end

    local cols = (b.w >= 46) and 2 or 1
    local colW = math.floor((b.w - 2 - (cols - 1)) / cols)
    local padW = 0
    for i = 1, #rows do padW = math.max(padW, #(rows[i][1] .. ":")) end
    padW = padW + 1

    -- The bars matter more than the tail of the stat list, so drop rows from
    -- the bottom until the capacity panel and the buttons fit.
    local function rowsHeight(n) return math.ceil(n / cols) + 2 end
    local buttonY = b.y + b.h - 1
    local barsH = math.min(math.max(#pool.drives(), 0) * 2 + 2, math.max(b.h - rowsHeight(#rows) - 3, 0))
    while #rows > 4 and rowsHeight(#rows) + barsH + 2 > b.h do
        table.remove(rows)
        barsH = math.min(math.max(#pool.drives(), 0) * 2 + 2, math.max(b.h - rowsHeight(#rows) - 3, 0))
    end
    -- The bars are the point of this screen, so if they would not fit at all,
    -- give up stat rows for them rather than drawing an empty panel. A bar
    -- needs two rows plus the panel borders, hence the floor of 4.
    while #rows > 8 and barsH < 4 do
        table.remove(rows)
        barsH = math.min(math.max(#pool.drives(), 0) * 2 + 2, math.max(b.h - rowsHeight(#rows) - 3, 0))
    end

    local infoH = rowsHeight(#rows)
    root:add(widgets.panel({ x = b.x, y = b.y, w = b.w, h = infoH, title = "DISK POOL" }))
    for i, r in ipairs(rows) do
        local c = ((i - 1) % cols) + 1
        local rr = math.floor((i - 1) / cols)
        local value = r[2]
        root:add(widgets.label({
            x = b.x + 2 + (c - 1) * (colW + 1), y = b.y + 1 + rr, w = colW - 1,
            value = function()
                local v = value
                if type(v) == "function" then v = v() end
                return widget.pad(r[1] .. ":", padW) .. tostring(v)
            end,
            role = r[3],
        }))
    end

    -- One bar per drive: filled = used / (used + free). 1.75 has no total size,
    -- so the bar is an estimate built from a bounded walk; a truncated walk is
    -- labelled "~" instead of pretending to be exact.
    local barsY = b.y + infoH + 1
    local drives = pool.drives()
    if #drives > 0 and barsH >= 4 then
        local shown = math.min(#drives, math.floor((barsH - 2) / 2))
        -- Say when the list is cut short, rather than letting a few bars pass
        -- for the whole pool.
        local capTitle = (shown < #drives) and ("CAPACITY  " .. shown .. " of " .. #drives .. " shown") or "CAPACITY"
        root:add(widgets.panel({ x = b.x, y = barsY, w = b.w, h = barsH, title = capTitle }))
        for i = 1, shown do
            local d = drives[i]
            local y = barsY + 1 + (i - 1) * 2
            local free, used = d.free, d.used or 0
            local max = (type(free) == "number") and (free + used) or 1
            root:add(widgets.progress({
                x = b.x + 2, y = y, w = b.w - 4, h = 1,
                value = function()
                    local cur = pool.get(d.side)
                    if not cur or type(cur.free) ~= "number" then return 0 end
                    return (cur.used or 0)
                end,
                max = function()
                    local cur = pool.get(d.side)
                    if not cur or type(cur.free) ~= "number" then return 1 end
                    return (cur.used or 0) + cur.free
                end,
                caption = function()
                    local cur = pool.get(d.side)
                    if not cur then return d.side .. " (gone)" end
                    local mark = cur.truncated and "~" or ""
                    local state = cur.mount and (cur.readOnly and "read-only" or "writable") or "no data"
                    local slot = cur.slot and ("  slot " .. tostring(cur.slot)) or ""
                    -- "side: label" first, the way the drive is named in the
                    -- Drives panel; the mount path is in the panel, not here.
                    return string.format("%s: %s  %s  %s free of %s%s%s",
                        d.side, driveName(cur), state,
                        pool.bytes(cur.free), pool.bytes((cur.used or 0) + (cur.free or 0)), mark, slot)
                end,
            }))
        end
    else
        root:add(widgets.panel({ x = b.x, y = barsY, w = b.w, h = math.max(barsH, 3), title = "CAPACITY" }))
        root:add(widgets.label({
            x = b.x + 2, y = barsY + 1, w = b.w - 4,
            -- Do not claim there are no drives when there simply is no room to
            -- draw their bars.
            value = (#drives == 0)
                    and "(no drive peripherals on this computer - attach a Disk Drive)"
                    or ("(" .. tostring(#drives) .. " drives: too little room for bars, see the Drives screen)"),
            role = "warn",
        }))
    end

    buttonRow(app, root, buttonY, actionDefs(app, { "rescan", "ping" }))
end

---------------------------------------------------------------------------
-- Drives: select one, act on it
---------------------------------------------------------------------------
local function renderDriveRow(s, x, y, w, d, idx, sel)
    local bg = sel and theme.c("selection") or theme.c("panel")
    local mark, role
    if not d.hasDisk then
        mark, role = "[EMPTY]", "dim"
    elseif not d.mount then
        mark, role = "[NODATA]", "warn"
    elseif d.readOnly then
        mark, role = "[R-ONLY]", "warn"
    else
        mark, role = "[OK]", "ok"
    end
    widget.text(s, x + 1, y, mark, theme.c(role), bg)
    local avail = math.max(w - 8, 8)
    -- The floppy's own label if it has one, otherwise the mount path. Named the
    -- same way as everywhere else: "<side>: <label>".
    local name = (d.label ~= nil and d.label ~= "") and d.label or tostring(d.mount or "-")
    local rest = string.format(" %-13s %-12s %s", d.side .. ":", name,
                               pool.bytes(d.free) .. " free")
    widget.text(s, x + 8, y, widget.clip(rest, avail),
        sel and theme.c("onAccent") or theme.c("text"), bg)
end

local function buildDrives(app, root)
    local b = app.body()

    -- Bottom-anchored buttons, then the label field, then the detail panel;
    -- the list absorbs whatever height is left.
    local buttonY = b.y + b.h - 1
    local fieldY  = buttonY - 1
    local detailH = 8
    local detailY = fieldY - detailH
    local listH = math.max(detailY - 1 - b.y, 1)

    local lst = widgets.list({
        x = b.x, y = b.y, w = b.w, h = listH,
        items = pool.drives,
        render = renderDriveRow,
        empty = "(no drive peripherals attached)",
        onSelect = function(d) selectedSide = d.side end,
    })
    root:add(lst)
    app.defaultKey = lst

    root:add(widgets.panel({ x = b.x, y = detailY, w = b.w, h = detailH, title = "DRIVE" }))
    local lines = {
        -- The drive's name, the same "<side>: <disk label>" the Overview bars
        -- use, so a rename is visible right at the top of the panel.
        { "name",     function()
              local d = selectedDrive()
              if not d then return "(nothing selected)" end
              return d.side .. ": " .. driveName(d)
          end },
        { "mount",    function() local d = selectedDrive(); return d and tostring(d.mount or "-") or "-" end },
        { "disk id",  function() local d = selectedDrive(); return d and tostring(d.diskID or "-") or "-" end },
        { "free",     function() local d = selectedDrive(); return d and pool.bytes(d.free) or "-" end },
        { "files",    function()
              local d = selectedDrive()
              if not d then return "-" end
              return tostring(d.files or 0) .. " files, " .. pool.bytes(d.used)
                  .. (d.truncated and " (walk truncated - a floor, not the truth)" or "")
          end },
        { "array",    function()
              local d = selectedDrive()
              if not d then return "-" end
              if d.manifest then return "slot " .. tostring(d.slot) .. "  " .. tostring(d.member) end
              return tostring(d.manifestErr or "no manifest")
          end },
    }
    for i, r in ipairs(lines) do
        root:add(widgets.label({
            x = b.x + 2, y = detailY + 1 + (i - 1), w = b.w - 4,
            value = function() return widget.pad(r[1] .. ":", 11) .. tostring(r[2]()) end,
            role = (i == 1) and "text" or "dim",
        }))
    end

    -- The label field: click it, type, Enter. os.loadAPI of the ROM field widget
    -- keeps a history, so Up/Down recall previous labels.
    root:add(widgets.field({
        x = b.x, y = fieldY, w = b.w, h = 1,
        placeholder = "type a disk label, press enter to set it",
        onEnter = function(line)
            local d = selectedDrive()
            if not d then app.notify("select a drive to label first", "warn") return end
            local ok, msg = pool.setLabel(d.side, line)
            keepSelection()
            app.notify(msg, ok and "ok" or "error")
            -- The name is shown in the panel and on the Overview bars, so redraw
            -- both now rather than on the next rescan.
            app.rebuild()
        end,
    }))

    buttonRow(app, root, buttonY, actionDefs(app, { "rescan", "eject", "forget" }))
end

---------------------------------------------------------------------------
-- Builder: build arrays, join disks to them, repair them. This replaces the
-- one "Init array" button, which enrolled every writable disk it could find and
-- gave you no way to say "just this one".
--
-- Three sub-screens behind a tab strip, because the three jobs want different
-- lists:
--   Devices  every drive anywhere on the network, and whether it can be used
--   New      the disks you picked, the slots they would take, then one Create
--   Repair   the arrays that exist, their members and holes, and Join/Forget
--
-- Selection is deliberately explicit: a drive is only touched if you picked it.
---------------------------------------------------------------------------
local builderTab = "devices"
local picked     = {}          -- key -> true: the pending New-array selection
local selArray   = nil         -- array id selected on the Repair tab
local selKey     = nil         -- free drive selected on a list
local selMember  = nil         -- member selected on the Repair tab
local pendingName = nil        -- name for the array being built
local pendingMode  = "plain"
-- Files live on the Arrays screen now: a pool is something you open and look
-- inside, while the Builder is only for making and fixing them.
local BUILDER_TABS = { { id = "devices", label = "Devices" },
                       { id = "new",     label = "New" },
                       { id = "repair",  label = "Repair" } }

local function sortedDrives()
    local out = {}
    local all = pool.drives()
    for i = 1, #all do table.insert(out, all[i]) end
    table.sort(out, function(a, b)
        local ca, cb = a.computer or 0, b.computer or 0
        if ca ~= cb then return ca < cb end
        return tostring(a.key) < tostring(b.key)
    end)
    return out
end

local function pickedKeys()
    local raw = {}
    for key, on in pairs(picked) do if on then table.insert(raw, key) end end
    return builder.sortedKeys(raw)
end

local function forgetPicks()
    -- a disk that left the pool must not stay selected and silently come back
    for key, on in pairs(picked) do
        if not pool.get(key) then picked[key] = nil end
    end
end

local function togglePick(key)
    local r = pool.get(key)
    if not r then return false, "that drive is gone" end
    if picked[key] then
        picked[key] = nil
        return true, "deselected " .. key
    end
    local ok, why = builder.usable(r)
    if not ok then return false, key .. ": " .. why end
    picked[key] = true
    return true, "selected " .. key .. " (" .. why .. ")"
end

---------------------------------------------------------------------------
-- Builder actions
---------------------------------------------------------------------------
local function doCreate(app)
    local keys = pickedKeys()
    local ok, msg = builder.create(keys, { mode = pendingMode, name = pendingName })
    app.notify(msg, ok and "ok" or "error")
    if ok then
        picked = {}
        builderTab = "repair"
        selArray = nil
    end
    app.rebuild()
end

local function doJoin(app)
    if not selArray then app.notify("select an array first", "warn") return end
    if not selKey then app.notify("select a free disk first", "warn") return end
    local ok, msg = builder.join(selArray, selKey)
    app.notify(msg, ok and "ok" or "error")
    app.rebuild()
end

local function doForgetMember(app)
    if not selMember then app.notify("select a member to forget", "warn") return end
    local ok, msg = builder.leave(selMember)
    app.notify(msg, ok and "ok" or "error")
    if selMember == selKey then selKey = nil end
    selMember = nil
    app.rebuild()
end

local function doRename(app)
    if not selArray then app.notify("select an array first", "warn") return end
    local ok, msg = builder.rename(selArray, pendingName or "")
    app.notify(msg, ok and "ok" or "error")
    pendingName = nil
    app.rebuild()
end

local function doPing(app)
    if app.pingHosts == nil then
        app.notify("this server has no network (started with --no-net?)", "warn")
        return
    end
    app.pingHosts()
    app.notify("asked the network for its drives", "dim")
end

local function doAddFree(app)
    local keys = builder.suggest()
    for i = 1, #keys do picked[keys[i]] = true end
    app.notify("selected " .. #keys .. " free disk(s)", "ok")
    app.rebuild()
end

local function doClearPick(app)
    picked = {}
    app.notify("selection cleared", "dim")
    app.rebuild()
end

---------------------------------------------------------------------------
-- Files tab: what the array actually holds, and who holds it
---------------------------------------------------------------------------
local inArray      = nil         -- pool opened on the Arrays screen, nil = the list
local selFile      = nil         -- file selected in that pool
local armDelete    = nil         -- file name armed for the confirming click

local function arrayLabel()
    local a = pool.arraySummary(selArray)
    if a.id == nil then return "no array selected" end
    return tostring(a.name or a.id) .. "  (" .. tostring(a.id) .. ", " .. tostring(a.mode) .. ")"
end

local function fileItems(arrayID)
    local out = {}
    local entries = files.ls(arrayID)
    local a = pool.arraySummary(arrayID)
    for i = 1, #entries do
        local e = entries[i]
        local missing = (a.members and #a.members - #e.members) or 0
        out[#out + 1] = {
            name = e.name, members = e.members,
            -- ARMED goes first: a 51-wide screen clips the end of the row, and
            -- an armed delete that you cannot see is worse than one you can.
            text = (armDelete == e.name and "! " or "  ") .. e.name
                   .. " [" .. #e.members .. "/" .. (a.members and #a.members or 0) .. "]"
                   .. (missing > 0 and "  not on every member" or ""),
        }
    end
    return out
end

local function renderFileRow(s, x, y, w, it, idx, sel)
    local bg = sel and theme.c("selection") or theme.c("panel")
    local fg = sel and theme.c("onAccent") or theme.c("text")
    widget.text(s, x + 1, y, widget.clip(it.text, w - 2), fg, bg)
end

local function doGetFile(app)
    if not selFile then app.notify("select a file first", "warn") return end
    local text, info = files.get(selFile, selArray)
    if text == nil then
        app.notify(tostring(info), "error")
        app.rebuild()
        return
    end
    -- Copy it onto THIS computer's disk: the one place a file can land without
    -- asking a floppy to hold it.
    -- Where "this computer" is, in 1.75 terms. A path is resolved by its first
    -- segment, which has to name a mounted drive, and the computer's own
    -- writable disk is mounted "hdd" (Computer builds its FileSystem with
    -- new FileSystem("hdd", rootMount)) - so a relative "dcget/x" resolves to
    -- nothing at all.
    local writable = nil
    local okRO, ro = pcall(fs.isReadOnly, "hdd")
    if okRO and ro == false then writable = "hdd/dcget" end
    if writable == nil then
        app.notify("read it but this computer has no writable hdd to save it on", "error")
        app.rebuild()
        return
    end
    pcall(fs.makeDir, writable)
    local dest = fs.combine(writable, selFile)
    local okH, h = pcall(fs.open, dest, "w")
    if not okH or h == nil then
        app.notify("read it but could not save: " .. tostring(okH and "no handle" or h), "error")
        app.rebuild()
        return
    end
    local okW, werr = pcall(h.write, text)
    pcall(h.flush)
    pcall(h.close)
    if not okW then app.notify("could not save: " .. tostring(werr), "error") app.rebuild() return end
    local msg = "saved " .. selFile .. " (" .. #text .. " bytes) to /" .. dest
    local style = "ok"
    if info.conflicts and info.conflicts > 0 then
        msg = msg .. "  WARNING: " .. tostring(info.why)
        style = "warn"
    end
    app.notify(msg, style)
    app.rebuild()
end

local function doDeleteFile(app)
    if not selFile then app.notify("select a file first", "warn") return end
    if armDelete ~= selFile then
        -- deleting user data is not a single click, unlike ejecting a floppy
        armDelete = selFile
        app.notify("press Delete selected again to remove " .. selFile, "warn")
        app.rebuild()
        return
    end
    armDelete = nil
    local ok, msg = files.remove(selFile, selArray)
    app.notify(msg, ok and "ok" or "error")
    selFile = nil
    app.rebuild()
end

local function registerBuilderActions(app)
    app.registerAction("create",   { label = "Create", style = "primary",
                                     run = function() doCreate(app) end })
    app.registerAction("join",     { label = "Join disk", style = "primary",
                                     run = function() doJoin(app) end })
    app.registerAction("forgetm",  { label = "Forget", style = "danger",
                                     run = function() doForgetMember(app) end })
    app.registerAction("rename",   { label = "Rename", style = "normal",
                                     run = function() doRename(app) end })
    -- Add free disks is the action this tab exists for, so it is the one that
    -- gets the primary face: a row where every button is the same grey reads as
    -- a row of labels, not controls.
    app.registerAction("addfree",  { label = "Free disks", style = "primary",
                                     run = function() doAddFree(app) end })
    app.registerAction("clearpick",{ label = "Clear", style = "normal",
                                     run = function() doClearPick(app) end })
    app.registerAction("back",     { label = "Back", style = "normal",
                                     run = function()
                                         inArray = nil
                                         app.rebuild()
                                     end })
    app.registerAction("tobuilder", { label = "Builder", style = "normal",
                                     run = function()
                                         builderTab = "devices"
                                         app.show("builder")
                                     end })
    app.registerAction("torepair", { label = "Repair", style = "normal",
                                     run = function()
                                         builderTab = "repair"
                                         selArray = inArray
                                         app.show("builder")
                                     end })
    app.registerAction("getfile",  { label = "Get file", style = "primary",
                                     run = function() doGetFile(app) end })
    app.registerAction("delfile",  { label = "Delete", style = "danger",
                                     run = function() doDeleteFile(app) end })
    app.registerAction("ping",     { label = "Hosts", style = "normal",
                                     run = function() doPing(app) end })
end

