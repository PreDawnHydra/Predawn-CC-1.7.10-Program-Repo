local function renderModeRow(s, x, y, w, m, idx, sel)
    local bg = theme.c("panel")
    local role = m.ready and "text" or "warn"
    local line = string.format(" %-8s %s", m.id, m.ready and "" or "(not implemented yet)")
    widget.text(s, x + 1, y, widget.clip(line, w - 2),
        (pendingMode == m.id) and theme.c("onAccent") or theme.c(role),
        (pendingMode == m.id) and theme.c("selection") or bg)
end

local function builderNew(app, root, b, y, h)
    local keys = pickedKeys()
    local p = builder.plan(keys, { mode = pendingMode, name = pendingName })

    -- Mode strip on the left, plan on the right; on a narrow screen the plan
    -- goes under the modes instead of beside them.
    local modeW = 10
    local wide = b.w >= 44
    local modeH = 2 + #builder.modes()
    local planX = wide and (b.x + modeW + 1) or b.x
    local planW = wide and (b.w - modeW - 1) or b.w
    local planY = wide and y or (y + modeH + 1)
    local planH = wide and math.max(h - 3, 4) or math.max(h - modeH - 4, 4)

    root:add(widgets.panel({ x = b.x, y = y, w = modeW, h = modeH, title = "MODE" }))
    for i, m in ipairs(builder.modes()) do
        root:add(widgets.button({
            x = b.x + 1, y = y + 1 + (i - 1), w = modeW - 2, h = 1,
            label = m.id, style = (pendingMode == m.id) and "primary" or "normal",
            action = function()
                pendingMode = m.id
                app.rebuild()
            end,
        }))
    end

    root:add(widgets.panel({ x = planX, y = planY, w = planW, h = planH,
                             title = "PLAN" }))
    local iy = planY + 1
    local function line(text, role)
        if iy > planY + planH - 2 then return end
        root:add(widgets.label({ x = planX + 1, y = iy, w = planW - 2,
                                 value = text, role = role or "text" }))
        iy = iy + 1
    end

    line("name:  " .. (p.name or "(unnamed)") .. "   mode: " .. p.mode,
         p.name and "text" or "dim")
    line(#p.keys .. " disk(s), " .. pool.bytes(p.free) .. " free"
         .. (p.remote > 0 and (", " .. p.remote .. " behind a modem") or ""), "info")
    for i = 1, #p.lines do line(p.lines[i], "text") end
    for i = 1, #p.warnings do line("! " .. p.warnings[i], "error") end
    if #p.keys == 0 then
        line("(pick disks on the Devices tab, or press Add free disks)", "warn")
    end

    -- The name field sits under the plan: type, Enter, and the plan above
    -- updates. os.loadAPI keeps the ROM field's history, so Up recalls a name.
    local fieldY = planY + planH
    if fieldY <= b.y + b.h - 2 then
        root:add(widgets.field({
            x = b.x, y = fieldY, w = b.w, h = 1,
            placeholder = "type an array name, press enter",
            onEnter = function(line2)
                pendingName = line2
                app.rebuild()
            end,
        }))
    end
end

