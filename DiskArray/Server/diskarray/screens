---------------------------------------------------------------------------
local function arrayItems()
    local out = {}
    local all = pool.arrays()
    for i = 1, #all do
        local a = all[i]
        table.insert(out, {
            id = a.id, label = a.name, mode = a.mode,
            text = string.format("%-16s %-6s %s/%s %s", a.name or a.id, a.mode,
                                 a.present, a.expected, a.state),
            missing = #a.missing,
        })
    end
    return out
end

local function renderArrayRow(s, x, y, w, it, idx, sel)
    local bg = sel and theme.c("selection") or theme.c("panel")
    local role = (it.state == "ok") and "ok"
                 or (it.state == "degraded" and "warn" or "error")
    local fg = sel and theme.c("onAccent") or theme.c(role)
    widget.text(s, x + 1, y, widget.clip(it.text, w - 2), fg, bg)
end

local function memberItems(arrayID)
    local out = {}
    if not arrayID then return out end
    local a = pool.arraySummary(arrayID)
    local bySlot = {}
    for i = 1, #a.members do bySlot[a.members[i].slot] = a.members[i] end
    for slot = 1, a.expected do
        local r = bySlot[slot]
        if r then
            table.insert(out, { kind = "member", key = r.key, slot = slot,
                text = string.format("%-3s %-14s %-10s %s", slot, r.key,
                                     (r.label ~= nil and r.label ~= "") and r.label or "-",
                                     r.computer and ("host #" .. r.computer) or "local") })
        else
            table.insert(out, { kind = "hole", slot = slot,
                text = string.format("%-3s %-14s %s", slot, "-- MISSING --",
                                     "put a disk in and press Join selected") })
        end
    end
    return out
end

local function renderMemberRow(s, x, y, w, it, idx, sel)
    local bg = sel and theme.c("selection") or theme.c("panel")
    local role = (it.kind == "hole") and "error" or "text"
    local fg = sel and theme.c("onAccent") or theme.c(role)
    widget.text(s, x + 1, y, widget.clip(it.text, w - 2), fg, bg)
end

local function freeItems()
    local out = {}
    local c = builder.candidates()
    table.sort(c, function(a, b)
        local ca, cb = a.computer or 0, b.computer or 0
        if ca ~= cb then return ca < cb end
        return tostring(a.key) < tostring(b.key)
    end)
    for i = 1, #c do
        local r = c[i]
        table.insert(out, { key = r.key,
            text = string.format("%-14s %-10s %-9s %s", r.key,
                                 (r.label ~= nil and r.label ~= "") and r.label or "-",
                                 r.computer and ("host #" .. r.computer) or "local",
                                 pool.bytes(r.free or 0) .. " free") })
    end
    return out
end

local function builderRepair(app, root, b, y, h)
    -- Three stacked lists: which array, who is in it, what could join it.
    local arraysH = 3
    local freeH   = 3
    local memH    = math.max(h - (arraysH + 2) - (freeH + 2) - 2, 3)

    root:add(widgets.panel({ x = b.x, y = y, w = b.w, h = arraysH + 2, title = "ARRAYS" }))
    local la = widgets.list({
        x = b.x + 1, y = y + 1, w = b.w - 2, h = arraysH,
        items = arrayItems, render = renderArrayRow,
        empty = "(no arrays yet - build one on the New tab)",
        onSelect = function(it)
            selArray = it.id
            selMember = nil
            app.rebuild()
        end,
    })
    root:add(la)
    app.defaultKey = la
    y = y + arraysH + 2

    root:add(widgets.panel({ x = b.x, y = y, w = b.w, h = memH + 2,
                             title = "MEMBERS" }))
    local lm = widgets.list({
        x = b.x + 1, y = y + 1, w = b.w - 2, h = memH,
        items = function() return memberItems(selArray) end,
        render = renderMemberRow,
        empty = "(select an array above)",
        onSelect = function(it)
            if it.kind == "member" then
                selMember = it.key
                app.notify("selected " .. it.key .. " - Forget removes it from the array", "dim")
            else
                app.notify("slot " .. it.slot .. " is empty - pick a free disk below", "warn")
            end
            app.rebuild()
        end,
    })
    root:add(lm)
    y = y + memH + 2

    root:add(widgets.panel({ x = b.x, y = y, w = b.w, h = freeH + 2,
                             title = "FREE DISKS (join these)" }))
    local lf = widgets.list({
        x = b.x + 1, y = y + 1, w = b.w - 2, h = freeH,
        items = freeItems, render = renderMemberRow,
        empty = "(no free writable disk anywhere)",
        onSelect = function(it)
            selKey = it.key
            app.notify("selected " .. it.key .. " - Join puts it in the array", "dim")
            app.rebuild()
        end,
    })
    root:add(lf)
end

local function builderButtons()
    if builderTab == "devices" then
        return { "rescan", "ping", "addfree", "clearpick" }
    elseif builderTab == "new" then
        return { "create", "addfree", "clearpick" }
    end
    return { "join", "forgetm", "rename", "rescan" }
end

local function buildBuilder(app, root)
    forgetPicks()
    local b = app.body()
    root:add(widgets.tabs({
        x = b.x, y = b.y, w = b.w, h = 1,
        items = BUILDER_TABS, current = builderTab,
        onSelect = function(id)
            builderTab = id
            app.rebuild()
        end,
    }))

    local buttonY = b.y + b.h - 1
    local top = b.y + 2
    local contentH = buttonY - 1 - top
    if builderTab == "devices" then
        builderDevices(app, root, b, top, contentH)
    elseif builderTab == "new" then
        builderNew(app, root, b, top, contentH)
    else
        builderRepair(app, root, b, top, contentH)
    end
    buttonRow(app, root, buttonY, actionDefs(app, builderButtons()))
end

