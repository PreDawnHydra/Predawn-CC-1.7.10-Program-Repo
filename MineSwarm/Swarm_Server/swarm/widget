-- ===========================================================================
--  widget.lua   ->  global `widget`
-- ---------------------------------------------------------------------------
--  Base widget (bounds, visibility, focus, hit-testing, child tree) plus the
--  low-level drawing primitives every widget shares.
--
--  A "surface" is anything with setCursorPos/write/setTextColor/
--  setBackgroundColor -- a window object or a terminal. Everything here works
--  on either, which is what makes widgets reusable across screens/monitors.
--
--  CC 1.7.5 windows have no fill(), so fills are drawn with background-coloured
--  spaces; that keeps this file dependency-free (no paintutils/redirect).
-- ===========================================================================

local base = {}
base.__index = base

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------
function new(opts)
    opts = opts or {}
    return setmetatable({
        x = opts.x or 1, y = opts.y or 1,
        w = opts.w or 1, h = opts.h or 1,
        id       = opts.id,
        visible  = opts.visible ~= false,
        enabled  = opts.enabled ~= false,
        focused  = false,
        children = {},
        -- Optional per-instance overrides; when absent the base method below
        -- is used (metatable lookup), so nil is meaningful, not an error.
        drawSelf = opts.drawSelf,
        onClick  = opts.onClick,
        onKey    = opts.onKey,
        onScroll = opts.onScroll,
    }, base)
end

---------------------------------------------------------------------------
-- Geometry / state
---------------------------------------------------------------------------
function base.setBounds(self, x, y, w, h)
    self.x, self.y, self.w, self.h = x, y, w, h
end

function base.contains(self, px, py)
    return px >= self.x and px < self.x + self.w
       and py >= self.y and py < self.y + self.h
end

function base.setVisible(self, v) self.visible = v and true or false end
function base.setEnabled(self, v) self.enabled = v and true or false end

function base.add(self, child)
    table.insert(self.children, child)
    return child
end

function base.clearChildren(self)
    self.children = {}
end

---------------------------------------------------------------------------
-- Tree walk
---------------------------------------------------------------------------
function base.drawAll(self, surface)
    if not self.visible then return end
    -- NOTE: drawSelf/onClick/onKey/onScroll are called WITHOUT an implicit
    -- self. Every override is a closure over its own widget (w), so the first
    -- argument is the surface/event data, not the widget. Using a colon here
    -- would pass the widget as the surface.
    if self.drawSelf then self.drawSelf(surface) end
    for i = 1, #self.children do
        self.children[i]:drawAll(surface)
    end
end

-- Topmost widget under a point: children are tested back-to-front because the
-- last child drawn is the one visually on top.
function base.hitTest(self, px, py)
    if not self.visible or not self:contains(px, py) then return nil end
    for i = #self.children, 1, -1 do
        local hit = self.children[i]:hitTest(px, py)
        if hit then return hit end
    end
    return self
end

---------------------------------------------------------------------------
-- Default event handlers (override per widget; NO implicit self -- these are
-- called as plain functions, matching how the overrides in widgets.lua are
-- written as closures over their own widget).
---------------------------------------------------------------------------
function base.onClick(button, px, py) end
function base.onKey(key) end
function base.onScroll(dir, px, py) end

---------------------------------------------------------------------------
-- Drawing primitives
---------------------------------------------------------------------------
function fill(surface, x, y, w, h, bg)
    if w <= 0 or h <= 0 then return end
    surface.setBackgroundColor(bg)
    local blank = string.rep(" ", w)
    for row = y, y + h - 1 do
        surface.setCursorPos(x, row)
        surface.write(blank)
    end
end

-- Single-cell border rectangle with + - | corners (ASCII keeps this safe for
-- any resource-pack font).
function box(surface, x, y, w, h, fg, bg)
    fill(surface, x, y, w, h, bg)
    if w < 1 or h < 1 then return end
    surface.setTextColor(fg)
    surface.setBackgroundColor(bg)
    if w >= 2 and h >= 2 then
        surface.setCursorPos(x + 1, y)     ; surface.write(string.rep("-", w - 2))
        surface.setCursorPos(x + 1, y+h-1) ; surface.write(string.rep("-", w - 2))
        for row = y + 1, y + h - 2 do
            surface.setCursorPos(x, row)        ; surface.write("|")
            surface.setCursorPos(x + w - 1, row); surface.write("|")
        end
    end
    surface.setCursorPos(x, y)         ; surface.write("+")
    surface.setCursorPos(x + w - 1, y) ; surface.write("+")
    surface.setCursorPos(x, y + h - 1) ; surface.write("+")
    surface.setCursorPos(x + w - 1, y + h - 1); surface.write("+")
end

-- Write a title into the top border of a box.
function boxTitle(surface, x, y, w, title, fg, bg)
    if not title or title == "" or w < 4 then return end
    local label = clip(" " .. title .. " ", w - 2)
    surface.setTextColor(fg)
    surface.setBackgroundColor(bg)
    surface.setCursorPos(x + 1, y)
    surface.write(label)
end

function text(surface, x, y, str, fg, bg)
    surface.setCursorPos(x, y)
    surface.setTextColor(fg)
    surface.setBackgroundColor(bg)
    surface.write(tostring(str))
end

-- Truncate to exactly `n` cells (never wider than the cell it is drawn in).
function clip(str, n)
    str = tostring(str)
    if n <= 0 then return "" end
    if #str > n then return string.sub(str, 1, n) end
    return str
end

-- Truncate or pad to exactly `n` cells -- for table columns.
function pad(str, n)
    str = clip(str, n)
    if #str < n then return str .. string.rep(" ", n - #str) end
    return str
end
