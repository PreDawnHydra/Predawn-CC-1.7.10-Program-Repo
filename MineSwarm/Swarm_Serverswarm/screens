-- ===========================================================================
--  screens.lua   ->  global `screens`      (SERVER)
-- ---------------------------------------------------------------------------
--  Every screen is registered through screens.build(app). A screen is just a
--  builder that fills a root widget with reusable widgets, so adding a screen
--  is one registerScreen call and adding a button is one entry in
--  core.actionDefs().
-- ===========================================================================

local selectedId = nil   -- shared selection for the Turtles tab

---------------------------------------------------------------------------
-- Small layout helpers
---------------------------------------------------------------------------
local function buttonRow(app, root, y, defs)
    local b = app.body()
    local n = #defs
    if n == 0 then return end
    local gap = 1
    local bw = math.floor((b.w - (n - 1) * gap) / n)
    bw = math.max(math.min(bw, 18), 6)
    local x = b.x
    for i = 1, n do
        local d = defs[i]
        root:add(widgets.button({
            x = x, y = y, w = bw, h = 1,
            label = d.label, action = d.run, style = d.style or "normal",
        }))
        x = x + bw + gap
    end
end

local function renderTurtleRow(s, x, y, w, t, idx, selected)
    local bg = selected and theme.c("selection") or theme.c("panel")
    local online = core.isTurtleOnline(t)
    local mark = online and "[ON]" or "[STL]"
    widget.text(s, x + 1, y, mark, online and theme.c("ok") or theme.c("error"), bg)
    -- Columns are dropped from the right until the name has room, so a narrow
    -- content area still shows a readable row instead of a clipped tail.
    local avail = math.max(w - 5, 8)
    local parts = {
        string.format(" id=%-4s", tostring(t.id)),
        string.format(" f=%-4s", tostring(t.fuel or "-")),
        string.format(" i=%-3s", tostring(t.items or "-")),
        " " .. core.ageOf(t),
    }
    local tail = table.concat(parts)
    while #parts > 1 and (avail - 1 - #tail) < 6 do
        table.remove(parts)
        tail = table.concat(parts)
    end
    local nameW = math.max(avail - 1 - #tail, 4)
    local rest = " " .. widget.pad(tostring(t.name), nameW) .. tail
    widget.text(s, x + 5, y, widget.clip(rest, avail),
        selected and theme.c("onAccent") or theme.c("text"), bg)
end

---------------------------------------------------------------------------
-- Dashboard: labelled information plus quick-action buttons. Deliberately no
-- log spew and no fleet table -- the list lives on the Turtles screen, where
-- it can be scrolled and selected.
---------------------------------------------------------------------------
local function buildDashboard(app, root)
    local b = app.body()

    -- Most important first: on a short terminal the tail gets dropped so the
    -- action buttons always stay on screen.
    local rows = {
        { "server",      function() return core.address() end, "text" },
        { "turtles",     function() return core.turtleCount() end, "text" },
        { "online",      function() return core.onlineCount() end,
          function() return core.onlineCount() > 0 and "ok" or "warn" end },
        { "modem sides", function() return table.concat(core.modemSides(), ",") end, "dim" },
        { "stale after", function() return core.config().staleAfter .. "s" end, "dim" },
        { "palette",     function() return theme.name() end, "dim" },
    }

    local cols = (b.w >= 46) and 2 or 1
    local colW = math.floor((b.w - 2 - (cols - 1)) / cols)
    -- One space past the longest label, so values never butt up against them.
    local padW = 0
    for _, r in ipairs(rows) do padW = math.max(padW, #(r[1] .. ":")) end
    padW = padW + 1
    local function infoRows(n) return math.ceil(n / cols) + 2 end
    while #rows > 3 and infoRows(#rows) + 3 > b.h do table.remove(rows) end

    local infoH = infoRows(#rows)
    root:add(widgets.panel({ x = b.x, y = b.y, w = b.w, h = infoH, title = "FLEET" }))
    for i, r in ipairs(rows) do
        local c = ((i - 1) % cols) + 1
        local rr = math.floor((i - 1) / cols)
        root:add(widgets.label({
            x = b.x + 2 + (c - 1) * (colW + 1), y = b.y + 1 + rr, w = colW - 1,
            value = function() return widget.pad(r[1] .. ":", padW) .. tostring(r[2]()) end,
            role = r[3],
        }))
    end

    -- Quick actions come straight from the action registry, so adding an entry
    -- to core.actionDefs() puts a button here with no screen edits.
    local defs = {}
    for _, id in ipairs(app.actionOrder) do
        table.insert(defs, { label = app.actions[id].label, style = app.actions[id].style,
                             run = function() app.runAction(id) end })
    end
    local n = #defs
    local actY = b.y + infoH + 1
    local avail = math.max(b.y + b.h - actY, 0)
    if n > 0 and avail >= 1 then
        -- Prefer buttons at least 14 wide, but never spill past the bottom.
        local cols2 = math.max(1, math.min(n, math.floor((b.w - (n - 1)) / 14)))
        cols2 = math.min(math.max(cols2, math.ceil(n / avail)), n)
        local gap = 1
        local bw = math.min(math.max(math.floor((b.w - (cols2 - 1) * gap) / cols2), 6), 22)
        for i, d in ipairs(defs) do
            local c = ((i - 1) % cols2) + 1
            local rr = math.floor((i - 1) / cols2)
            root:add(widgets.button({
                x = b.x + (c - 1) * (bw + gap), y = actY + rr, w = bw, h = 1,
                label = d.label, style = d.style or "primary", action = d.run,
            }))
        end
    end
end

---------------------------------------------------------------------------
-- Turtles: select one, act on it individually
---------------------------------------------------------------------------
local function buildTurtles(app, root)
    local b = app.body()

    -- Bottom-anchored so the detail panel and buttons can never spill past the
    -- bottom edge on a short terminal; the list absorbs whatever is left.
    local buttonY = b.y + b.h - 1
    local detailH = 4
    local detailY = buttonY - detailH
    local listH = math.max(detailY - 1 - b.y, 1)

    local lst = widgets.list({
        x = b.x, y = b.y, w = b.w, h = listH,
        items = core.turtles,
        render = renderTurtleRow,
        empty = "(no turtles registered)",
        onSelect = function(t) selectedId = t.id end,
    })
    root:add(lst)
    app.defaultKey = lst

    root:add(widgets.panel({ x = b.x, y = detailY, w = b.w, h = detailH, title = "DETAIL" }))
    root:add(widgets.label({
        x = b.x + 2, y = detailY + 1, w = b.w - 3,
        value = function()
            local t = selectedId and core.turtleById(selectedId)
            if not t then return "no turtle selected" end
            return string.format("%s  fuel=%s items=%s state=%s seen=%s",
                t.name, tostring(t.fuel or "-"), tostring(t.items or "-"),
                tostring(t.state or "-"), core.ageOf(t))
        end, role = "text",
    }))
    root:add(widgets.label({
        x = b.x + 2, y = detailY + 2, w = b.w - 3,
        value = function()
            local t = selectedId and core.turtleById(selectedId)
            if not t then return "click a row or Right+Up" end
            return (core.isTurtleOnline(t) and "ONLINE" or "STALE") .. "  id=" .. t.id
        end,
        role = function()
            local t = selectedId and core.turtleById(selectedId)
            return (t and core.isTurtleOnline(t)) and "ok" or "warn"
        end,
    }))

    buttonRow(app, root, buttonY, {
        { label = "Ping",   style = "primary",
          run = function()
              if not selectedId then app.notify("select a turtle first", "warn") return end
              core.ping(selectedId); app.notify("pinged turtle " .. selectedId, "ok")
          end },
        { label = "Status", style = "primary",
          run = function()
              if not selectedId then app.notify("select a turtle first", "warn") return end
              core.sendCommand(selectedId, "status"); app.notify("status requested from " .. selectedId, "ok")
          end },
        { label = "Task",
          run = function()
              if not selectedId then app.notify("select a turtle first", "warn") return end
              core.sendCommand(selectedId, "task")
              app.notify("task sent (task system not implemented yet)", "warn")
          end },
    })
end

---------------------------------------------------------------------------
-- Cluster: bulk actions, built from the declarative action registry
---------------------------------------------------------------------------
local function buildCluster(app, root)
    local b = app.body()
    root:add(widgets.panel({ x = b.x, y = b.y, w = b.w, h = 3, title = "CLUSTER" }))
    root:add(widgets.label({ x = b.x + 2, y = b.y + 1, w = b.w - 3,
        value = function() return core.summary() end, role = "ok" }))

    local row = b.y + 4
    for _, id in ipairs(app.actionOrder) do
        local d = app.actions[id]
        root:add(widgets.button({
            x = b.x, y = row, w = math.min(b.w, 24), h = 1,
            label = d.label, style = d.style or "normal",
            action = function() app.runAction(id) end,
        }))
        root:add(widgets.label({ x = b.x + math.min(b.w, 24) + 2, y = row, w = b.w - math.min(b.w, 24) - 3,
            value = d.hint or "", role = "dim" }))
        row = row + 1
    end
end

---------------------------------------------------------------------------
-- Console: keeps the text commands available beside the buttons
---------------------------------------------------------------------------
local function buildConsole(app, root)
    local b = app.body()
    local logH = math.max(b.h - 2, 1)

    local view = widget.new({ x = b.x, y = b.y, w = b.w, h = logH })
    function view.drawSelf(s)
        widget.fill(s, view.x, view.y, view.w, view.h, theme.c("panel"))
        local lines = core.log()
        local startIdx = math.max(1, #lines - view.h + 1)
        local r = 0
        for i = startIdx, #lines do
            widget.text(s, view.x + 1, view.y + r, widget.clip(lines[i], view.w - 1),
                theme.c("dim"), theme.c("panel"))
            r = r + 1
        end
    end
    root:add(view)

    local f = widgets.field({
        x = b.x, y = b.y + logH, w = b.w, h = 1,
        placeholder = "type 'help' and press Enter",
        onEnter = function(line)
            if line ~= "" then core.dispatch("> " .. line) end
        end,
    })
    root:add(f)
    -- Focus the prompt by default; Tab releases it so the arrows drive the tabs.
    app.setFocus(f)
end

---------------------------------------------------------------------------
-- Settings: theme + about + quit
---------------------------------------------------------------------------
local function buildSettings(app, root)
    local b = app.body()
    root:add(widgets.panel({ x = b.x, y = b.y, w = b.w, h = 4, title = "THEME" }))
    root:add(widgets.label({ x = b.x + 2, y = b.y + 1, w = b.w - 3,
        value = function() return "active palette: " .. theme.name() end, role = "text" }))
    root:add(widgets.label({ x = b.x + 2, y = b.y + 2, w = b.w - 3,
        value = "edit swarm/theme to change colours", role = "dim" }))

    -- Palette buttons sit in one horizontal row so they never collide with the
    -- Quit row on a short terminal.
    local px = b.x
    for _, pname in ipairs(theme.list()) do
        local bw = math.max(#pname + 2, 8)
        root:add(widgets.button({
            x = px, y = b.y + 4, w = bw, h = 1, label = pname,
            style = (pname == theme.name()) and "primary" or "normal",
            action = function()
                theme.set(pname)
                app.notify("palette: " .. pname, "ok")
            end,
        }))
        px = px + bw + 1
    end

    root:add(widgets.button({
        x = b.x, y = b.y + b.h - 1, w = 10, h = 1, label = "Quit", style = "danger",
        action = function()
            -- Auto-start would relaunch us in 3s, so an explicit Quit writes a
            -- halt flag that the installed /startup loop checks.
            local f = fs.open("/halt", "w")
            if f then f.write("halted\n") f.close() end
            app.stop()
        end,
    }))
    root:add(widgets.label({ x = b.x + 12, y = b.y + b.h - 1, w = b.w - 13,
        value = "halts auto-start (/halt)", role = "dim" }))
end

---------------------------------------------------------------------------
-- Registration
---------------------------------------------------------------------------
function build(app)
    app.registerScreen("dashboard", "Dashboard", buildDashboard)
    app.registerScreen("turtles",   "Turtles",   buildTurtles)
    app.registerScreen("cluster",   "Cluster",   buildCluster)
    app.registerScreen("console",   "Console",   buildConsole)
    app.registerScreen("settings",  "Settings",  buildSettings)
end