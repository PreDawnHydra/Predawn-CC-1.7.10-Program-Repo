-- ===========================================================================
--  widgets.lua   ->  global `widgets`
-- ---------------------------------------------------------------------------
--  Reusable widget set. Every constructor returns a `widget` instance with
--  drawSelf/onClick/onKey overrides, so they compose, nest and hit-test the
--  same way. All colour comes from theme roles -- never hard-coded here.
-- ===========================================================================

---------------------------------------------------------------------------
-- button: bordered, clickable, keyboard-focusable
---------------------------------------------------------------------------
function button(opts)
    local w = widget.new(opts)
    w.kind = "button"
    w.focusable = true
    w.label  = opts.label or ""
    w.action = opts.action
    w.hint   = opts.hint
    w.style  = opts.style or "normal"   -- "normal" | "primary" | "danger"

    function w.drawSelf(s)
        local bg, fg
        if not w.enabled then
            bg, fg = theme.c("panel"), theme.c("dim")
        elseif w.focused then
            bg, fg = theme.c("buttonHi"), theme.c("onButtonHi")
        elseif w.style == "primary" then
            bg, fg = theme.c("buttonPrim"), theme.c("onButtonPrim")
        elseif w.style == "danger" then
            bg, fg = theme.c("buttonDang"), theme.c("onButtonDang")
        else
            bg, fg = theme.c("button"), theme.c("onButton")
        end
        -- Solid chip, no ASCII frame: the filled face is what reads as
        -- clickable, and CC 1.7.5's default font has no box-drawing glyphs.
        -- Focus/click feedback comes from the face colour changing.
        widget.fill(s, w.x, w.y, w.w, w.h, bg)
        local label = widget.clip(w.label, w.w - 2)
        local lx = w.x + math.floor((w.w - #label) / 2) + 1
        widget.text(s, lx, w.y + math.floor(w.h / 2), label, fg, bg)
    end

    function w.onClick(button_, px, py)
        if w.enabled and w.action then w.action(w) end
    end

    -- Enter activates a focused button, same as clicking it.
    function w.onKey(key)
        if key == keys.enter and w.enabled and w.action then w.action(w) end
    end
    return w
end

---------------------------------------------------------------------------
-- panel: titled frame; add children to it
---------------------------------------------------------------------------
function panel(opts)
    local w = widget.new(opts)
    w.title = opts.title
    function w.drawSelf(s)
        widget.box(s, w.x, w.y, w.w, w.h, theme.c("border"), theme.c("panel"))
        widget.boxTitle(s, w.x, w.y, w.w, w.title, theme.c("borderHi"), theme.c("panel"))
    end
    return w
end

---------------------------------------------------------------------------
-- label: static or live text (pass a function for live values)
---------------------------------------------------------------------------
function label(opts)
    local w = widget.new(opts)
    w.value = opts.value or ""
    w.role  = opts.role or "text"
    w.prefix = opts.prefix
    function w.drawSelf(s)
        local v = w.value
        if type(v) == "function" then v = v() end
        -- role may be a function so a value can change colour with its state.
        local r = w.role
        if type(r) == "function" then r = r() end
        local line = (w.prefix or "") .. tostring(v)
        widget.text(s, w.x, w.y, widget.clip(line, w.w), theme.c(r), theme.c("panel"))
    end
    return w
end

---------------------------------------------------------------------------
-- menu: vertical sidebar of items. Scrolls with the wheel once the items
-- overflow the available height, and shows a scrollbar gutter when they do.
-- Same selection model as tabs: `current` is what is shown, `highlight` is the
-- keyboard cursor, activate() commits it.
---------------------------------------------------------------------------
function menu(opts)
    local w = widget.new(opts)
    w.kind      = "menu"
    w.items     = opts.items or {}
    w.current   = opts.current or (w.items[1] and w.items[1].id)
    w.highlight = w.current
    w.onSelect  = opts.onSelect
    w.offset    = 0

    local function idxOf(id)
        for i = 1, #w.items do if w.items[i].id == id then return i end end
        return nil
    end

    function w.drawSelf(s)
        local n = #w.items
        widget.fill(s, w.x, w.y, w.w, w.h, theme.c("panel"))
        -- Keep the cursor on screen, then clamp the scroll window.
        local hi = idxOf(w.highlight)
        if hi then
            if hi <= w.offset then w.offset = hi - 1 end
            if hi > w.offset + w.h then w.offset = hi - w.h end
        end
        w.offset = math.max(math.min(w.offset, math.max(n - w.h, 0)), 0)
        local scrollable = n > w.h
        local rowW = scrollable and (w.w - 1) or w.w

        for r = 0, w.h - 1 do
            local i = w.offset + r + 1
            if i > n then break end
            local it = w.items[i]
            local y = w.y + r
            local bg, fg
            if it.id == w.current then
                bg, fg = theme.c("accent"), theme.c("onAccent")
            elseif it.id == w.highlight then
                bg, fg = theme.c("accentHi"), theme.c("onAccent")
            else
                bg, fg = theme.c("panel"), theme.c("text")
            end
            widget.fill(s, w.x, y, rowW, 1, bg)
            widget.text(s, w.x + 1, y, widget.clip(it.label, rowW - 2), fg, bg)
        end

        if scrollable then
            for r = 0, w.h - 1 do
                local mark = math.floor((r / w.h) * n) + 1
                local thumb = mark >= w.offset + 1 and mark <= w.offset + w.h
                -- The gutter is the last column *inside* the widget, not one past it.
                widget.text(s, w.x + w.w - 1, w.y + r, "|",
                    thumb and theme.c("scrollbarHi") or theme.c("scrollbar"), theme.c("panel"))
            end
        end
    end

    -- Up/Down: move the cursor, wrapping.
    function w.move(delta)
        local n = #w.items
        if n == 0 then return end
        local pos = idxOf(w.highlight) or 1
        pos = ((pos - 1 + delta) % n) + 1
        w.highlight = w.items[pos].id
    end

    -- Enter: commit the highlighted entry.
    function w.activate()
        if w.highlight ~= w.current then
            w.current = w.highlight
            if w.onSelect then w.onSelect(w.current) end
            return true
        end
        return false
    end

    function w.onClick(b, px, py)
        local r = py - w.y
        if r < 0 or r >= w.h then return end
        local i = w.offset + r + 1
        if i > #w.items then return end
        local it = w.items[i]
        w.highlight = it.id
        if it.id ~= w.current then
            w.current = it.id
            if w.onSelect then w.onSelect(it.id) end
        end
    end

    -- Wheel over the sidebar scrolls the sidebar (only once it overflows).
    function w.onScroll(dir, px, py)
        local maxOff = math.max(#w.items - w.h, 0)
        if maxOff == 0 then return end
        if dir > 0 then w.offset = math.min(w.offset + 1, maxOff)
        else w.offset = math.max(w.offset - 1, 0) end
    end
    return w
end

---------------------------------------------------------------------------
-- tabs: declarative tab bar. Adding a tab = adding one entry to w.items.
---------------------------------------------------------------------------
function tabs(opts)
    local w = widget.new(opts)
    w.kind      = "tabs"
    w.items     = opts.items or {}      -- { {id=, label=}, ... }
    w.current   = opts.current or (w.items[1] and w.items[1].id)
    w.highlight = w.current             -- keyboard cursor; Enter commits it
    w.onSelect  = opts.onSelect
    w._drawn    = {}                    -- item indices that fit on screen

    function w.drawSelf(s)
        local n = #w.items
        if n == 0 then return end
        -- Adaptive: full labels + gap, else drop the gap, else shrink labels
        -- evenly. Without this, 5 tabs need 52 cells and spill off a 51-wide
        -- computer screen.
        local widths, gap = {}, 1
        for i = 1, n do
            widths[i] = #w.items[i].label + 2
            w.items[i]._x, w.items[i]._w = nil, nil
        end
        local function total()
            local t = (n - 1) * gap
            for i = 1, n do t = t + widths[i] end
            return t
        end
        if total() > w.w then
            gap = 0
            if total() > w.w then
                local over = total() - w.w
                for i = 1, n do
                    local take = math.floor(over / n)
                    if i <= over % n then take = take + 1 end
                    widths[i] = math.max(widths[i] - take, 5)
                end
            end
        end
        local x = w.x
        for i = 1, n do
            local it = w.items[i]
            if x + widths[i] - 1 > w.x + w.w - 1 then break end
            local isCur = (it.id == w.current)
            local isHi  = (it.id == w.highlight)
            local bg, fg
            if isCur then
                bg, fg = theme.c("accent"), theme.c("onAccent")
            elseif isHi then
                bg, fg = theme.c("accentHi"), theme.c("onAccent")
            else
                bg, fg = theme.c("panel"), theme.c("dim")
            end
            widget.fill(s, x, w.y, widths[i], w.h, bg)
            widget.text(s, x + 1, w.y, widget.clip(it.label, widths[i] - 2), fg, bg)
            it._x, it._w = x, widths[i]   -- cached for hit-testing
            table.insert(w._drawn, i)
            x = x + widths[i] + gap
        end
    end

    -- Left/Right: move the cursor across the tabs that actually fit.
    function w.move(delta)
        if #w._drawn == 0 then return end
        local pos = 0
        for k, i in ipairs(w._drawn) do
            if w.items[i].id == w.highlight then pos = k break end
        end
        if pos == 0 then
            pos = 1
        else
            pos = ((pos - 1 + delta) % #w._drawn) + 1
        end
        w.highlight = w.items[w._drawn[pos]].id
    end

    -- Enter: commit the highlighted tab.
    function w.activate()
        if w.highlight ~= w.current then
            w.current = w.highlight
            if w.onSelect then w.onSelect(w.current) end
            return true
        end
        return false
    end

    function w.onClick(b, px, py)
        for i = 1, #w.items do
            local it = w.items[i]
            if it._x and px >= it._x and px < it._x + it._w then
                w.highlight = it.id
                if it.id ~= w.current then
                    w.current = it.id
                    if w.onSelect then w.onSelect(it.id) end
                end
                return
            end
        end
    end
    return w
end

---------------------------------------------------------------------------
-- list: scrollable rows, selection, mouse + keyboard.
--   items  : table, or a function returning a fresh table (live data)
--   render : fn(surface, x, y, width, item, index, selected) for custom rows
---------------------------------------------------------------------------
function list(opts)
    local w = widget.new(opts)
    w.kind = "list"
    w.focusable = true
    w.items    = opts.items or {}
    w.render   = opts.render
    w.onSelect = opts.onSelect
    w.empty    = opts.empty or "(empty)"
    w.selected = 0
    w.offset   = 0

    local function resolve()
        if type(w.items) == "function" then return w.items() end
        return w.items
    end

    function w.drawSelf(s)
        local rows = w.h
        local data = resolve()
        local total = #data
        if w.selected > total then w.selected = total end
        if w.selected > 0 and w.selected <= w.offset then w.offset = w.selected - 1 end
        if w.offset > total - 1 then w.offset = math.max(total - 1, 0) end

        widget.fill(s, w.x, w.y, w.w, w.h, theme.c("panel"))
        local showScrollbar = total > rows
        local rowW = showScrollbar and (w.w - 1) or w.w

        for r = 0, rows - 1 do
            local idx = w.offset + r + 1
            local y = w.y + r
            if idx > total then break end
            local item = data[idx]
            local sel = (idx == w.selected)
            if sel then widget.fill(s, w.x, y, rowW, 1, theme.c("selection")) end
            if w.render then
                w.render(s, w.x, y, rowW, item, idx, sel)
            else
                local fg = sel and theme.c("onAccent") or theme.c("text")
                widget.text(s, w.x + 1, y, widget.clip(tostring(item), rowW - 1), fg, theme.c("panel"))
            end
        end

        if total == 0 then
            widget.text(s, w.x + 1, w.y, widget.clip(w.empty, w.w - 1), theme.c("dim"), theme.c("panel"))
        elseif showScrollbar then
            for r = 0, rows - 1 do
                local mark = math.floor((r / rows) * total) + 1
                local isThumb = mark >= w.offset + 1 and mark <= w.offset + rows
                -- The gutter is the last column *inside* the widget, not one past it.
                widget.text(s, w.x + w.w - 1, w.y + r, "|",
                    isThumb and theme.c("scrollbarHi") or theme.c("scrollbar"), theme.c("panel"))
            end
        end
    end

    function w.onClick(b, px, py)
        local r = py - w.y
        if r < 0 or r >= w.h then return end
        local idx = w.offset + r + 1
        local data = resolve()
        if idx <= #data then
            w.selected = idx
            if w.onSelect then w.onSelect(data[idx], idx) end
        end
    end

    function w.onKey(key)
        local data = resolve()
        local total = #data
        if total == 0 then return end
        if key == keys.down then
            w.selected = math.min(w.selected + 1, total)
        elseif key == keys.up then
            w.selected = math.max(w.selected - 1, 1)
        elseif key == keys.pageDown then
            w.selected = math.min(w.selected + w.h, total)
        elseif key == keys.pageUp then
            w.selected = math.max(w.selected - w.h, 1)
        else
            return
        end
        if w.selected < w.offset + 1 then w.offset = w.selected - 1 end
        if w.selected > w.offset + w.h - 1 then w.offset = w.selected - w.h + 1 end
        if w.onSelect then w.onSelect(data[w.selected], w.selected) end
    end

    -- CC mouse_scroll direction: -1 = scroll up, 1 = scroll down.
    function w.onScroll(dir, px, py)
        local data = resolve()
        local maxOff = math.max(#data - w.h, 0)
        if dir > 0 then w.offset = math.min(w.offset + 1, maxOff)
        else w.offset = math.max(w.offset - 1, 0) end
    end
    return w
end

---------------------------------------------------------------------------
-- progress: value/max bar with an optional caption
---------------------------------------------------------------------------
function progress(opts)
    local w = widget.new(opts)
    w.value = opts.value or 0
    w.max   = opts.max or 100
    w.caption = opts.caption
    function w.drawSelf(s)
        local v, m = w.value, w.max
        if type(v) == "function" then v = v() end
        if type(m) == "function" then m = m() end
        m = (m and m > 0) and m or 1
        v = math.max(math.min(v or 0, m), 0)
        local barW = math.max(w.w - 4, 1)
        local filled = math.floor((v / m) * barW + 0.5)
        widget.text(s, w.x, w.y, "[", theme.c("border"), theme.c("panel"))
        for i = 1, barW do
            local ch = i <= filled and "#" or "."
            local col = i <= filled and theme.c("bar") or theme.c("barTrack")
            widget.text(s, w.x + 1 + i - 1, w.y, ch, col, theme.c("panel"))
        end
        widget.text(s, w.x + w.w - 1, w.y, "]", theme.c("border"), theme.c("panel"))
        if w.caption then
            widget.text(s, w.x, w.y + 1, widget.clip(w.caption, w.w), theme.c("dim"), theme.c("panel"))
        end
    end
    return w
end

---------------------------------------------------------------------------
-- statusbar: one row, left and right text (strings or functions)
---------------------------------------------------------------------------
function statusbar(opts)
    local w = widget.new(opts)
    w.left  = opts.left or ""
    w.right = opts.right or ""
    function w.drawSelf(s)
        widget.fill(s, w.x, w.y, w.w, w.h, theme.c("panel"))
        local l, r = w.left, w.right
        if type(l) == "function" then l = l() end
        if type(r) == "function" then r = r() end
        widget.text(s, w.x, w.y, widget.clip(l, w.w), theme.c("dim"), theme.c("panel"))
        if r and r ~= "" then
            local rs = tostring(r)
            -- Clamp so a hint longer than the terminal cannot draw off-screen.
            local rx = math.max(w.x, w.x + w.w - #rs)
            widget.text(s, rx, w.y, widget.clip(rs, w.x + w.w - rx), theme.c("borderHi"), theme.c("panel"))
        end
    end
    return w
end

---------------------------------------------------------------------------
-- field: single-line text input driven by the app event loop (no read()).
--   Keeps a history so Up/Down recall previous commands.
---------------------------------------------------------------------------
function field(opts)
    local w = widget.new(opts)
    w.kind = "field"
    w.focusable = true
    w.placeholder = opts.placeholder or ""
    w.onEnter     = opts.onEnter
    w.buffer      = ""
    w.history     = {}
    w.hpos        = 0

    function w.drawSelf(s)
        local show = w.buffer
        if show == "" and w.placeholder ~= "" then show = w.placeholder end
        local fg = (w.buffer == "") and theme.c("dim") or theme.c("text")
        widget.fill(s, w.x, w.y, w.w, 1, theme.c("panel"))
        widget.text(s, w.x, w.y, ">", theme.c("borderHi"), theme.c("panel"))
        widget.text(s, w.x + 1, w.y, widget.clip(show, w.w - 1), fg, theme.c("panel"))
        if w.focused then
            s.setCursorBlink(true)
            s.setCursorPos(w.x + 1 + math.min(#w.buffer, w.w - 2), w.y)
        end
    end

    local function submit()
        if w.buffer ~= "" then
            table.insert(w.history, w.buffer)
            if #w.history > 25 then table.remove(w.history, 1) end
        end
        local line = w.buffer
        w.buffer, w.hpos = "", 0
        if w.onEnter then w.onEnter(line) end
    end

    function w.onKey(key)
        if key == keys.enter then
            submit()
        elseif key == keys.backspace then
            if #w.buffer > 0 then w.buffer = string.sub(w.buffer, 1, -2) end
        elseif key == keys.delete then
            w.buffer = ""
        elseif key == keys.up or key == keys.down then
            if #w.history > 0 then
                w.hpos = (key == keys.up) and math.min(w.hpos + 1, #w.history) or math.max(w.hpos - 1, 0)
                if w.hpos == 0 then w.buffer = ""
                else w.buffer = w.history[#w.history - w.hpos + 1] end
            end
        end
    end

    function w.onClick(b, px, py)
        w.focused = true
    end
    return w
end

-- Called by the app for "char" events when a field has focus.
function appendChar(w, ch)
    if w and w.focused and w.buffer then
        w.buffer = w.buffer .. ch
        w.hpos = 0
    end
end